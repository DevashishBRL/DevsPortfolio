    }

    createTree(-5.5, 0.8, -5.5, 1.1, 0);
    createTree(6.2, 0.8, -4.8, 0.95, 1);
    createTree(7.5, 0.8, 5.2, 1.2, 2);
    createTree(-6.8, 0.8, 5.5, 1.0, 1);
    createTree(-18.5, 0.5, 0.0, 1.3, 0);
    createTree(18.5, 0.5, 0.0, 1.25, 2);
    createTree(0.0, 0.6, 18.5, 1.4, 1);
    createTree(-7.5, 1.8, -17.5, 0.9, 0);
    createTree(7.5, 1.8, -17.5, 0.9, 1);
    createTree(-16.0, 2.0, -8.0, 0.85, 2);
    createTree(16.0, 1.6, -6.5, 0.9, 0);

    // ── 7. Gentle Ambient Dust Motes ──
    const particleCount = 28;
    const particleGeo = new THREE.BufferGeometry();
    const particlePositions = new Float32Array(particleCount * 3);
    const particleVelocities: { x: number; y: number; z: number }[] = [];

    for (let i = 0; i < particleCount; i++) {
      particlePositions[i * 3] = (Math.random() - 0.5) * 44;
      particlePositions[i * 3 + 1] = 1.0 + Math.random() * 14;
      particlePositions[i * 3 + 2] = (Math.random() - 0.5) * 44;
      particleVelocities.push({
        x: (Math.random() - 0.5) * 0.3,
        y: 0.15 + Math.random() * 0.25,
        z: (Math.random() - 0.5) * 0.3,
      });
    }
    particleGeo.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));

    const particleMat = new THREE.PointsMaterial({
      color: 0xfef08a,
      size: 0.45,
      transparent: true,
      opacity: 0.45,
      blending: THREE.AdditiveBlending,
    });
    const particleSystem = new THREE.Points(particleGeo, particleMat);
    worldGroup.add(particleSystem);

    // ── RTS Guided Exploration Camera Controller ──
    const cameraController = new RTSCameraController(camera);

    // ── UI Selection Synchronizer ──
    function selectDestination(id: string) {
      const dest = destinationsData.find((d) => d.id === id);
      if (!dest) return;

      // Update Panel Content
      if (panelNum) panelNum.textContent = dest.num;
      if (panelCoords) panelCoords.textContent = dest.locationLabel;
      if (panelCategory) panelCategory.textContent = dest.category;
      if (panelTitle) panelTitle.textContent = dest.title;
      if (panelTagline) panelTagline.textContent = dest.specialty;
      if (panelDesc) panelDesc.textContent = dest.description;
      if (panelActionText) panelActionText.textContent = dest.actionLabel;
      if (panelActionBtn) panelActionBtn.setAttribute('href', dest.actionHref);
      if (panelIndicator) panelIndicator.style.backgroundColor = dest.themeColor;
      if (infoPanel) {
        infoPanel.style.setProperty('--panel-accent', dest.themeColor);
        infoPanel.classList.add('is-visible');
      }

      // Update HUD
      if (hudActiveDest) hudActiveDest.textContent = dest.title.toUpperCase();

      // Update Tabs
      tabBtns.forEach((btn) => {
        const isMatch = btn.getAttribute('data-district') === id;
        btn.classList.toggle('is-active', isMatch);
        btn.setAttribute('aria-selected', String(isMatch));
      });

      // Update Lower Nav Cards
      navCards.forEach((card) => {
        const isMatch = card.getAttribute('data-target') === id;
        card.classList.toggle('is-selected', isMatch);
        card.setAttribute('aria-pressed', String(isMatch));
      });

      // Position dynamic spotlight over the selected district for grounded emphasis
      const targetPos = dest.targetPos;
      districtSpot.target.position.set(targetPos[0], targetPos[1], targetPos[2]);
      districtSpot.position.set(targetPos[0] + 5, targetPos[1] + 24, targetPos[2] + 5);
      districtSpot.intensity = 1.8;

      // Guided RTS Camera Travel to Destination (with panel framing offset)
      cameraController.travelToDestination(id, true);

      // Notify Companion Bot
      window.dispatchEvent(new CustomEvent('campus-destination-change', { detail: { id } }));
    }

    function resetToOverview() {
      if (hudActiveDest) hudActiveDest.textContent = 'CAMPUS OVERVIEW';
      if (infoPanel) {
        infoPanel.classList.remove('is-visible');
      }
      districtSpot.intensity = 0;
      cameraController.returnToOverview();

      // Clear selection states from tabs and cards
      tabBtns.forEach((btn) => {
        btn.classList.remove('is-active');
        btn.setAttribute('aria-selected', 'false');
      });
      navCards.forEach((card) => {
        card.classList.remove('is-selected');
        card.setAttribute('aria-pressed', 'false');
      });

      window.dispatchEvent(new CustomEvent('campus-destination-change', { detail: { id: 'overview' } }));
    }

    if (hudResetBtn) {
      hudResetBtn.addEventListener('click', resetToOverview);
    }

    if (cardCloseBtn) {
      cardCloseBtn.addEventListener('click', resetToOverview);
    }

    const hudBackBtn = document.getElementById('hud-back-to-intro');
    if (hudBackBtn) {
      hudBackBtn.addEventListener('click', () => {
        resetToOverview();
        window.dispatchEvent(new CustomEvent('return-to-intro'));
      });
    }

    // Trigger canvas resize when world mode is entered
    window.addEventListener('enter-world-mode', () => {
      setTimeout(onResize, 50);
      setTimeout(onResize, 200);
    });

    // Tab Listeners
    tabBtns.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.getAttribute('data-district');
        if (id) selectDestination(id);
      });
    });

    // Card Listeners
    navCards.forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-target');
        if (id) selectDestination(id);
      });
    });

    // ── Raycasting on 3D Canvas ──
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();

    canvas.addEventListener('click', (event) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(mouse, camera);
      const hits = raycaster.intersectObjects(interactiveMeshes.map((m) => m.mesh), true);

      if (hits.length > 0) {
        let hitObj: THREE.Object3D | null = hits[0].object;
        while (hitObj && !hitObj.userData.districtId) {
          hitObj = hitObj.parent;
        }
        if (hitObj && hitObj.userData.districtId) {
          selectDestination(hitObj.userData.districtId);
        }
      }
    });

    // ── Resize Handler ──
    function onResize() {
      if (!container || !renderer || !camera) return;
      const w = container.clientWidth;
      const h = container.clientHeight;
      cameraController.handleResize(w, h, frustumSize);
      renderer.setSize(w, h);
    }
    window.addEventListener('resize', onResize);

    // ── Animation Loop ──
    const clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      const delta = clock.getDelta();
      const time = clock.getElapsedTime();

      // 1. Ambient District Silhouettes Motion
      // Foundry mast beacon & screen
      mastBeacon.position.y = 14.6 + Math.sin(time * 2.2) * 0.22;
      mastBeaconGlow.position.copy(mastBeacon.position);
      screenMesh.rotation.y = 0.25 + Math.sin(time * 1.4) * 0.05;

      // Commons stage light core float & spin
      lanternCore.rotation.y += delta * 0.55;
      lanternCore.rotation.x = Math.sin(time * 1.5) * 0.15;
      lanternCore.position.y = 1.8 + Math.sin(time * 1.8) * 0.12;
      commonsGlowSprite.position.y = lanternCore.position.y;
      commonsPointLight.position.y = lanternCore.position.y + 0.6;

      // Commons Audience subtle idle movements
      for (let i = 0; i < audienceMembers.length; i++) {
        const aud = audienceMembers[i];
        aud.mesh.rotation.y += Math.sin(time * aud.speed + aud.phase) * 0.005;
      }

      // Smooth Tangent-Aligned Campus Shuttle Travel
      for (let s = 0; s < campusShuttles.length; s++) {
        const sht = campusShuttles[s];
        const pA = sht.waypoints[sht.currentIdx];
        const nextIdx = (sht.currentIdx + 1) % sht.waypoints.length;
        const pB = sht.waypoints[nextIdx];

        sht.t += delta * sht.speed;
        if (sht.t >= 1.0) {
          sht.t = 0;
          sht.currentIdx = nextIdx;
        } else {
          sht.mesh.position.lerpVectors(pA, pB, sht.t);
          sht.mesh.lookAt(pB.x, sht.mesh.position.y, pB.z);
        }
      }

      // Campus Pedestrian Movement
      for (let p = 0; p < pedestrians.length; p++) {
        const ped = pedestrians[p];
        const pA = ped.waypoints[ped.currentIdx];
        const nextIdx = (ped.currentIdx + 1) % ped.waypoints.length;
        const pB = ped.waypoints[nextIdx];
        ped.t += delta * ped.speed;
        if (ped.t >= 1.0) {
          ped.t = 0;
          ped.currentIdx = nextIdx;
        } else {
          ped.mesh.position.lerpVectors(pA, pB, ped.t);
          ped.mesh.lookAt(pB.x, ped.mesh.position.y, pB.z);
        }
      }

      // Agricultural Crop Soft Sway
      for (let c = 0; c < cropPlants.length; c++) {
        const cp = cropPlants[c];
        cp.mesh.rotation.z = Math.sin(time * cp.speed + cp.phase) * 0.04;
      }

      // Lab dish scan & robotic arm inspection micro-sweep
      labDishRotator.rotation.y = Math.sin(time * 0.6) * 0.45;
      armForearm.rotation.z = 0.65 + Math.sin(time * 1.2) * 0.08;
      // Sync inspection point light to arm inspection head in world space
      labArmLight.position.set(-6.4, 5.6 + Math.sin(time * 1.2) * 0.2, -7.8);

      // Yard gantry carriage subtle travel & toolhead glow
      gantryCarriage.position.z = 2.4 + Math.sin(time * 1.1) * 1.2;
      gantryToolTip.position.z = gantryCarriage.position.z;
      gantryGlow.position.z = gantryCarriage.position.z;
      yardPointLight.position.z = 12 + gantryCarriage.position.z;

      // Observatory celestial dome atmospheric rotation
      obsDomePivot.rotation.y = time * 0.08;

      // Outlook Lighthouse Rotating Yellow Light Beam
      lighthouseBeamGroup.rotation.y = time * 0.65;
      vaneArm.rotation.y = Math.sin(time * 0.5) * 0.4 + time * 0.1;

      // Reflective Pond gentle water surface ripple
      pondMesh.scale.set(1.0 + Math.sin(time * 2.0) * 0.015, 1.0, 1.0 + Math.cos(time * 2.0) * 0.015);

      // 2. Gentle Foliage Wind Sway
      for (let i = 0; i < swayingFoliage.length; i++) {
        const item = swayingFoliage[i];
        item.mesh.rotation.z = Math.sin(time * item.speed + item.phase) * 0.04;
      }

      // 3. Subtle Floating Terrarium Dust Motes
      const positions = particleGeo.attributes.position.array as Float32Array;
      for (let i = 0; i < particleCount; i++) {
        positions[i * 3 + 1] += particleVelocities[i].y * delta;
        positions[i * 3] += particleVelocities[i].x * delta;
        positions[i * 3 + 2] += particleVelocities[i].z * delta;

        if (positions[i * 3 + 1] > 16) {
          positions[i * 3 + 1] = 1.0;
        }
      }
      particleGeo.attributes.position.needsUpdate = true;

      cameraController.update(delta);

      renderer.render(scene, camera);
    }

    animate();

    // Check system preference for dark mode initially
    if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
      updateLightingTheme(true);
    }

    // Remove loading overlay
    if (loading) {
      loading.style.opacity = '0';
      setTimeout(() => {
        loading.style.display = 'none';
      }, 300);
    }

    // Start with composed campus overview
    cameraController.resetToOverviewInstant();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWorld);
  } else {
    initWorld();
  }
</script>

