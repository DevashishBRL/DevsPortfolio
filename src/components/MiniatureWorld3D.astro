---
/**
 * MiniatureWorld3D.astro
 * 
 * Interactive 3D Miniature Terrarium World for Devashish Tambade.
 * Crafted with Three.js: layered architectural diorama, sculpted terrarium plinth,
 * distinct district silhouettes, curving pathways, coordinated day/night lighting,
 * and smooth isometric exploration.
 */

import RobotCompanion from './RobotCompanion.astro';
import { getDestinations } from '../data/destinations';

const base = import.meta.env.BASE_URL;
const destinations = getDestinations(base);
---

<div class="mw3d-wrapper" id="miniature-world-3d">
  <div class="mw3d-container">
    <!-- Header Section Meta -->
    <div class="section-meta mw3d-header">
      <div class="mw3d-status-badge">
        <span class="mw3d-pulse-dot" aria-hidden="true"></span>
        <span>Interactive Terrarium Diorama · Isometric Exploration</span>
      </div>
      <h2 class="section-title mw3d-title" id="mw-heading">
        An Explorable Miniature World
      </h2>
      <p class="section-description mw3d-subtitle">
        A tactile terrarium habitat capturing Devashish's engineering laboratory, software foundry, and design observatory. Rotate the diorama, select pins or landmarks, or use the district navigator below.
      </p>
    </div>

    <!-- Main Stage: 3D Canvas + Integrated Field-Note Panel -->
    <div class="mw3d-stage">
      <!-- ── 3D Viewport Frame ── -->
      <div class="mw3d-canvas-wrap" id="mw3d-canvas-container" tabindex="0" role="region" aria-label="3D Interactive Terrarium Canvas">
        <div class="mw3d-loading-overlay" id="mw3d-loading">
          <div class="mw3d-spinner"></div>
          <p>Cultivating Terrarium Habitat...</p>
        </div>

        <canvas id="mw3d-webgl-canvas" class="mw3d-canvas"></canvas>

        <!-- Static Fallback if WebGL unavailable -->
        <noscript>
          <div class="mw3d-fallback-notice">
            <p><strong>JavaScript is disabled.</strong> You can explore all destinations through the accessible controls below.</p>
          </div>
        </noscript>
        <div class="mw3d-fallback-notice" id="mw3d-webgl-error" style="display: none;">
          <p><strong>WebGL acceleration is unavailable.</strong> All destinations and portfolio links remain fully accessible below.</p>
        </div>

        <!-- On-Canvas Ambient HUD Controls -->
        <div class="mw3d-hud" aria-hidden="true">
          <div class="mw3d-hud-left">
            <span class="hud-mode-pill">TERRARIUM</span>
            <span class="hud-coord" id="hud-active-dest">CAMPUS OVERVIEW</span>
            <span class="hud-sep">/</span>
            <span class="hud-sub">ISOMETRIC DIORAMA</span>
          </div>
          <div class="mw3d-hud-right">
            <button type="button" class="hud-btn hud-btn--back" id="hud-back-to-intro" title="Return to introduction screen">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
              <span>Back to Intro</span>
            </button>
            <button type="button" class="hud-btn" id="hud-theme-toggle" title="Toggle Daylight / Dusk Ambience">
              <span id="hud-theme-icon" aria-hidden="true">☀️</span>
              <span id="hud-theme-label">Daylight</span>
            </button>
            <button type="button" class="hud-btn" id="hud-reset-view" title="Reset to Campus Overview">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
              </svg>
              <span>Overview</span>
            </button>
          </div>
        </div>
      </div>

      <!-- ── Right / Floating Field-Note Information Panel ── -->
      <aside class="mw3d-field-panel" id="mw3d-info-panel" aria-live="polite" aria-atomic="true">
        <!-- Integrated Companion Guide in Field Panel -->
        <RobotCompanion mode="guide" />

        <div class="field-panel-header-row">
          <div class="field-panel-badge">
            <span class="field-indicator" id="mw3d-panel-indicator" aria-hidden="true"></span>
            <span class="field-district-num" id="mw3d-panel-num">01 / LAB</span>
          </div>
          <button type="button" class="field-panel-close-btn" id="mw3d-card-close" aria-label="Close information card and return to overview">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <p class="field-coords" id="mw3d-panel-coords">Northwest Plateau · Mechatronics &amp; Robotics High-Bay</p>

        <div class="field-panel-content">
          <p class="field-category" id="mw3d-panel-category">Engineering &amp; Robotics</p>
          <h3 class="field-title" id="mw3d-panel-title">The Lab</h3>
          <p class="field-tagline" id="mw3d-panel-tagline">Autonomous Systems, Hardware &amp; Biomechatronics</p>
          <p class="field-description" id="mw3d-panel-desc">
            Where mechanical hardware and firmware converge: modular articulated robotic arms, wearable medical device enclosures (TORUS), and accessible prosthetic research (EasyProsthetics).
          </p>
        </div>

        <div class="field-panel-actions">
          <a href={`${base}work/`} class="btn btn-mw3d-action" id="mw3d-panel-action-btn">
            <span id="mw3d-panel-action-text">Explore Engineering &amp; Research</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <!-- Quick 6-Destination Selector Strip -->
        <div class="field-selector-strip" role="tablist" aria-label="Destinations quick selector">
          {destinations.map((dest, idx) => (
            <button
              type="button"
              role="tab"
              class={`field-tab-btn ${idx === 0 ? 'is-active' : ''}`}
              id={`tab-btn-${dest.id}`}
              aria-selected={idx === 0 ? 'true' : 'false'}
              aria-controls="mw3d-info-panel"
              data-district={dest.id}
              style={`--tab-color: ${dest.themeColor};`}
            >
              <span class="tab-index">{dest.num.split('/')[0]}</span>
              <span class="tab-name">{dest.title.replace('The ', '')}</span>
            </button>
          ))}
        </div>
      </aside>
    </div>

    <!-- ── Lower 6-Destination Cards Strip (Direct Accessible Touch Navigation) ── -->
    <div class="mw3d-destinations-grid" role="list" aria-label="Campus destinations">
      {destinations.map((dest, idx) => (
        <button
          type="button"
          class={`mw3d-nav-card ${idx === 0 ? 'is-selected' : ''}`}
          role="listitem"
          data-target={dest.id}
          aria-pressed={idx === 0 ? 'true' : 'false'}
          style={`--dest-accent: ${dest.themeColor};`}
        >
          <div class="nav-card-top">
            <span class="nav-card-num">{dest.num}</span>
            <span class="nav-card-dot" aria-hidden="true"></span>
          </div>
          <span class="nav-card-title">{dest.title}</span>
          <span class="nav-card-cat">{dest.category}</span>
          <span class="nav-card-desc">{dest.tagline}</span>
        </button>
      ))}
    </div>
  </div>
</div>

<!-- Three.js Interactive 3D World Script -->
<script>
  import * as THREE from 'three';
  import { RTSCameraController } from '../utils/rtsCameraController';
  import { getDestinations } from '../data/destinations';
  import { createGlowSprite, createGroundSpill } from '../utils/glowEffects';

  const base = import.meta.env.BASE_URL;
  const destinationsData = getDestinations(base);

  function initWorld() {
    const container = document.getElementById('mw3d-canvas-container');
    const canvas = document.getElementById('mw3d-webgl-canvas') as HTMLCanvasElement;
    const loading = document.getElementById('mw3d-loading');
    const errNotice = document.getElementById('mw3d-webgl-error');

    if (!container || !canvas) return;

    if (canvas.dataset.initialized === 'true') return;
    canvas.dataset.initialized = 'true';

    // UI elements
    const infoPanel = document.getElementById('mw3d-info-panel');
    const panelNum = document.getElementById('mw3d-panel-num');
    const panelCoords = document.getElementById('mw3d-panel-coords');
    const panelCategory = document.getElementById('mw3d-panel-category');
    const panelTitle = document.getElementById('mw3d-panel-title');
    const panelTagline = document.getElementById('mw3d-panel-tagline');
    const panelDesc = document.getElementById('mw3d-panel-desc');
    const panelActionBtn = document.getElementById('mw3d-panel-action-btn');
    const panelActionText = document.getElementById('mw3d-panel-action-text');
    const panelIndicator = document.getElementById('mw3d-panel-indicator');
    const cardCloseBtn = document.getElementById('mw3d-card-close');
    const hudActiveDest = document.getElementById('hud-active-dest');
    const hudResetBtn = document.getElementById('hud-reset-view');
    const hudThemeToggle = document.getElementById('hud-theme-toggle');
    const hudThemeIcon = document.getElementById('hud-theme-icon');
    const hudThemeLabel = document.getElementById('hud-theme-label');

    const tabBtns = document.querySelectorAll('.field-tab-btn');
    const navCards = document.querySelectorAll('.mw3d-nav-card');

    // ── Three.js Scene Setup ──
    const scene = new THREE.Scene();
    
    // Day vs Night palette configurations
    let isNightMode = false;
    const dayBg = new THREE.Color(0x0c131d);
    const nightBg = new THREE.Color(0x05080e);
    scene.background = dayBg;
    scene.fog = new THREE.FogExp2(0x0c131d, 0.0075);

    // ── Orthographic Camera ──
    const aspect = container.clientWidth / container.clientHeight;
    const frustumSize = 56;
    const camera = new THREE.OrthographicCamera(
      (-frustumSize * aspect) / 2,
      (frustumSize * aspect) / 2,
      frustumSize / 2,
      -frustumSize / 2,
      0.1,
      1000
    );

    const overviewTarget = new THREE.Vector3(0, 1.2, 0);
    const overviewCamPos = new THREE.Vector3(38, 44, 38);
    camera.position.copy(overviewCamPos);
    camera.lookAt(overviewTarget);

    // Renderer with ACESFilmic Tone Mapping and sRGB output
    let renderer: THREE.WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        powerPreference: 'high-performance',
      });
    } catch (e) {
      if (errNotice) errNotice.style.display = 'block';
      if (loading) loading.style.display = 'none';
      return;
    }

    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    // ── Palette & Materials (Dimensional Miniature Response) ──
    // Landscape & Plinth
    const matTerrariumRim = new THREE.MeshPhysicalMaterial({
      color: 0xc8e4ff,
      roughness: 0.04,
      transmission: 0.92,
      thickness: 1.8,
      transparent: true,
      opacity: 0.82,
      metalness: 0.02,
      ior: 1.52,
    });
    const matPedestal = new THREE.MeshStandardMaterial({ color: 0x121720, roughness: 0.85, metalness: 0.2 });
    const matSoil = new THREE.MeshStandardMaterial({ color: 0x221812, roughness: 0.95 });
    const matTerrainBase = new THREE.MeshStandardMaterial({ color: 0x2d4724, roughness: 0.88 }); // Deep moss green
    const matTerrainHigh = new THREE.MeshStandardMaterial({ color: 0x3d5f30, roughness: 0.84 }); // Sunlit terrace green
    const matTerraceRock = new THREE.MeshStandardMaterial({ color: 0x485147, roughness: 0.82 }); // Shaded rock strata
    const matTerraceRockDark = new THREE.MeshStandardMaterial({ color: 0x303730, roughness: 0.88 }); // Deep stone
    const matSandstone = new THREE.MeshStandardMaterial({ color: 0xcbb99d, roughness: 0.65 }); // Warm sandstone
    const matCobblePath = new THREE.MeshStandardMaterial({ color: 0x766d62, roughness: 0.72 }); // Winding pathways
    const matKerbStone = new THREE.MeshStandardMaterial({ color: 0x544c43, roughness: 0.82 }); // Path borders
    
    // Architecture & Construction
    const matPlasterWarm = new THREE.MeshStandardMaterial({ color: 0xded5c0, roughness: 0.58 }); // Limestone stucco
    const matPlasterLight = new THREE.MeshStandardMaterial({ color: 0xeee7d9, roughness: 0.50 }); // Crisp pavilion walls
    const matTimberDark = new THREE.MeshStandardMaterial({ color: 0x463124, roughness: 0.78 }); // Cedar wood framing
    const matRoofTileTerracotta = new THREE.MeshStandardMaterial({ color: 0xc25330, roughness: 0.52 }); // Terracotta
    const matRoofSlate = new THREE.MeshStandardMaterial({ color: 0x28343e, roughness: 0.42 }); // Slate shingles
    const matMetalBrass = new THREE.MeshStandardMaterial({ color: 0xd99f3b, roughness: 0.28, metalness: 0.85 });
    const matMetalSteel = new THREE.MeshStandardMaterial({ color: 0x8291a0, roughness: 0.32, metalness: 0.80 });
    const matDarkIron = new THREE.MeshStandardMaterial({ color: 0x1e2227, roughness: 0.55, metalness: 0.70 });

    // Emissive & Feature Accents with High Physical Values for Natural Flare
    const matWindowAmber = new THREE.MeshStandardMaterial({
      color: 0xf59e0b,
      roughness: 0.15,
      emissive: 0xd97706,
      emissiveIntensity: 0.65,
    });
    const matWindowCyan = new THREE.MeshStandardMaterial({
      color: 0x38bdf8,
      roughness: 0.15,
      emissive: 0x0284c7,
      emissiveIntensity: 0.70,
    });
    const matWindowRose = new THREE.MeshStandardMaterial({
      color: 0xf43f5e,
      roughness: 0.15,
      emissive: 0xe11d48,
      emissiveIntensity: 0.75,
    });
    const matFoliage = new THREE.MeshStandardMaterial({ color: 0x22543d, roughness: 0.85 });
    const matFoliageLight = new THREE.MeshStandardMaterial({ color: 0x326c4f, roughness: 0.82 });
    const matFoliageWarm = new THREE.MeshStandardMaterial({ color: 0x47642f, roughness: 0.85 });
    const matTreeTrunk = new THREE.MeshStandardMaterial({ color: 0x38281d, roughness: 0.92 });
    
    // Living Water with subtle surface specularity
    const matWaterPond = new THREE.MeshStandardMaterial({
      color: 0x164664,
      roughness: 0.08,
      metalness: 0.6,
      transparent: true,
      opacity: 0.92,
    });

    // ── Coordinated Atmospheric Lighting Hierarchy ──
    // 1. Warm cream ambient baseline
    // 1. Environmental ambient lighting baseline
    const ambientLight = new THREE.AmbientLight(0xfef3c7, 0.50);
    scene.add(ambientLight);

    // 2. Hemisphere sky/ground fill for grounded contact contrast
    const hemiLight = new THREE.HemisphereLight(0xdbeafe, 0x1c1917, 0.40);
    scene.add(hemiLight);

    // 3. Primary Sun directional key light with crisp shadows
    const sunLight = new THREE.DirectionalLight(0xfffaed, 2.2);
    sunLight.position.set(42, 60, 32);
    sunLight.castShadow = true;
    sunLight.shadow.mapSize.width = 2048;
    sunLight.shadow.mapSize.height = 2048;
    sunLight.shadow.camera.near = 0.5;
    sunLight.shadow.camera.far = 160;
    sunLight.shadow.camera.left = -32;
    sunLight.shadow.camera.right = 32;
    sunLight.shadow.camera.top = 32;
    sunLight.shadow.camera.bottom = -32;
    sunLight.shadow.bias = -0.0003;
    scene.add(sunLight);

    // 4. Cool blue architectural rim kicker
    const rimFillLight = new THREE.DirectionalLight(0x7dd3fc, 0.55);
    rimFillLight.position.set(-32, 28, -28);
    scene.add(rimFillLight);

    // 5. Ground bounce fill light
    const groundBounceLight = new THREE.DirectionalLight(0xfde68a, 0.20);
    groundBounceLight.position.set(10, -12, 10);
    scene.add(groundBounceLight);

    // 6. Dynamic district highlight spotlight
    const districtSpot = new THREE.SpotLight(0xffedd5, 0, 55, Math.PI / 4, 0.6, 1.2);
    districtSpot.position.set(0, 32, 0);
    scene.add(districtSpot);
    scene.add(districtSpot.target);

    // 7. Localized Point Lights for true physical emissive illumination
    // Commons Stage Presentation Light
    const commonsPointLight = new THREE.PointLight(0xf59e0b, 1.5, 14, 1.8);
    commonsPointLight.position.set(0, 2.4, 0);
    scene.add(commonsPointLight);

    // Yard Prototyping Workshop Cyan Light
    const yardPointLight = new THREE.PointLight(0x38bdf8, 1.4, 12, 2.0);
    yardPointLight.position.set(-15.8, 3.8, 14.4);
    scene.add(yardPointLight);

    // Outlook Lighthouse Beacon Warm Yellow PointLight
    const outlookPointLight = new THREE.PointLight(0xfef08a, 2.0, 28, 1.4);
    outlookPointLight.position.set(0, 19.5, -16);
    scene.add(outlookPointLight);

    // Observatory Dome Interior Warm Light
    const obsPointLight = new THREE.PointLight(0xfbbf24, 1.2, 12, 2.0);
    obsPointLight.position.set(12, 5.2, 12);
    scene.add(obsPointLight);

    // Lab Inspection Spot Light (mounted to robotic arm base area)
    const labArmLight = new THREE.PointLight(0xf59e0b, 1.5, 10, 2.0);
    labArmLight.position.set(-5.5, 5.0, -8.0);
    scene.add(labArmLight);

    // Dedicated streetlight lamp material with toggleable emissive
    const matStreetlampGlow = new THREE.MeshStandardMaterial({
      color: 0x222222,
      emissive: 0x000000,
      emissiveIntensity: 0.0,
      roughness: 0.4,
    });
    const streetlightSprites: THREE.Sprite[] = [];

    function updateLightingTheme(night: boolean) {
      isNightMode = night;
      if (night) {
        scene.background = nightBg;
        scene.fog = new THREE.FogExp2(0x070c16, 0.009);
        ambientLight.color.setHex(0x1a2638);
        ambientLight.intensity = 0.52;
        hemiLight.color.setHex(0x60a5fa);
        hemiLight.groundColor.setHex(0x18241b);
        hemiLight.intensity = 0.45;
        sunLight.color.setHex(0x93c5fd); // Cool moonlit directional key
        sunLight.intensity = 1.15;
        rimFillLight.color.setHex(0x38bdf8);
        rimFillLight.intensity = 0.65;
        groundBounceLight.intensity = 0.12;
        
        // Emissives activate at dusk
        matWindowAmber.emissiveIntensity = 1.25;
        matWindowCyan.emissiveIntensity = 1.35;
        matWindowRose.emissiveIntensity = 1.35;
        matWaterPond.color.setHex(0x0c253b);
        
        // Streetlights activate at dusk
        matStreetlampGlow.color.setHex(0xfef08a);
        matStreetlampGlow.emissive.setHex(0xf59e0b);
        matStreetlampGlow.emissiveIntensity = 1.1;
        streetlightSprites.forEach(s => s.visible = true);
        
        // Local point lights provide warm pools of illumination
        commonsPointLight.intensity = 2.6;
        yardPointLight.intensity = 2.2;
        outlookPointLight.intensity = 3.2;
        obsPointLight.intensity = 2.0;
        labArmLight.intensity = 2.2;
        renderer.toneMappingExposure = 1.18;

        if (hudThemeIcon) hudThemeIcon.textContent = '🌙';
        if (hudThemeLabel) hudThemeLabel.textContent = 'Dusk';
      } else {
        scene.background = dayBg;
        scene.fog = new THREE.FogExp2(0x0c131d, 0.0075);
        ambientLight.color.setHex(0xfef3c7);
        ambientLight.intensity = 0.50;
        hemiLight.color.setHex(0xdbeafe);
        hemiLight.groundColor.setHex(0x1c1917);
        hemiLight.intensity = 0.40;
        sunLight.color.setHex(0xfffaed);
        sunLight.intensity = 2.2;
        rimFillLight.color.setHex(0x7dd3fc);
        rimFillLight.intensity = 0.55;
        groundBounceLight.intensity = 0.20;

        matWindowAmber.emissiveIntensity = 0.55;
        matWindowCyan.emissiveIntensity = 0.60;
        matWindowRose.emissiveIntensity = 0.65;
        matWaterPond.color.setHex(0x164664);

        // Streetlights shut off in daylight
        matStreetlampGlow.color.setHex(0x334155);
        matStreetlampGlow.emissive.setHex(0x000000);
        matStreetlampGlow.emissiveIntensity = 0.0;
        streetlightSprites.forEach(s => s.visible = false);

        commonsPointLight.intensity = 1.4;
        yardPointLight.intensity = 1.2;
        outlookPointLight.intensity = 1.8;
        obsPointLight.intensity = 1.1;
        labArmLight.intensity = 1.2;
        renderer.toneMappingExposure = 1.05;

        if (hudThemeIcon) hudThemeIcon.textContent = '☀️';
        if (hudThemeLabel) hudThemeLabel.textContent = 'Daylight';
      }
    }
    if (hudThemeToggle) {
      hudThemeToggle.addEventListener('click', () => {
        updateLightingTheme(!isNightMode);
      });
    }

    // ── World Geometry Group ──
    const worldGroup = new THREE.Group();
    scene.add(worldGroup);

    // Interactive clickable meshes container
    const interactiveMeshes: { mesh: THREE.Object3D; id: string }[] = [];
    function registerInteractive(obj: THREE.Object3D, id: string) {
      obj.userData.districtId = id;
      interactiveMeshes.push({ mesh: obj, id });
    }

    // ── 1. Terrarium Enclosure & Layered Island Base ──
    const plinthBase = new THREE.Mesh(new THREE.CylinderGeometry(27.5, 29, 3.2, 48), matPedestal);
    plinthBase.position.y = -2.2;
    plinthBase.receiveShadow = true;
    worldGroup.add(plinthBase);

    const soilLayer = new THREE.Mesh(new THREE.CylinderGeometry(26.8, 27.4, 1.8, 48), matSoil);
    soilLayer.position.y = -0.7;
    soilLayer.receiveShadow = true;
    worldGroup.add(soilLayer);

    const bedrockLayer = new THREE.Mesh(new THREE.CylinderGeometry(26.5, 27.0, 0.6, 48), matTerraceRockDark);
    bedrockLayer.position.y = 0.0;
    bedrockLayer.receiveShadow = true;
    worldGroup.add(bedrockLayer);

    const mainLandscape = new THREE.Mesh(new THREE.CylinderGeometry(26.2, 26.8, 1.2, 48), matTerrainBase);
    mainLandscape.position.y = 0.4;
    mainLandscape.receiveShadow = true;
    worldGroup.add(mainLandscape);

    const glassRimGeo = new THREE.TorusGeometry(26.6, 0.35, 16, 64);
    glassRimGeo.rotateX(Math.PI / 2);
    const glassRimMesh = new THREE.Mesh(glassRimGeo, matTerrariumRim);
    glassRimMesh.position.y = 1.2;
    worldGroup.add(glassRimMesh);

    const glassSkirtGeo = new THREE.CylinderGeometry(26.7, 26.7, 1.4, 64, 1, true);
    const glassSkirtMat = new THREE.MeshPhysicalMaterial({
      color: 0x93c5fd,
      roughness: 0.08,
      transmission: 0.90,
      thickness: 1.2,
      transparent: true,
      opacity: 0.45,
      metalness: 0.05,
    });
    const glassSkirtMesh = new THREE.Mesh(glassSkirtGeo, glassSkirtMat);
    glassSkirtMesh.position.y = 1.7;
    worldGroup.add(glassSkirtMesh);

    const rimBrassGeo = new THREE.TorusGeometry(26.7, 0.12, 12, 64);
    rimBrassGeo.rotateX(Math.PI / 2);
    const rimBrassMesh = new THREE.Mesh(rimBrassGeo, matMetalBrass);
    rimBrassMesh.position.y = 0.85;
    worldGroup.add(rimBrassMesh);

    // ── 2. Topographical Masterplan & Clean Elevated Terraces ──
    // A. Northwest High Tech Plateau (The Lab)
    const labPlatform = new THREE.Mesh(new THREE.CylinderGeometry(10.0, 11.0, 1.8, 28), matTerraceRock);
    labPlatform.position.set(-12, 1.3, -12);
    labPlatform.receiveShadow = true;
    worldGroup.add(labPlatform);

    const labWall = new THREE.Mesh(new THREE.CylinderGeometry(10.3, 10.5, 0.45, 28), matDarkIron);
