    function createCurvedRoad(p0: THREE.Vector3, p1: THREE.Vector3, p2: THREE.Vector3, width: number, isPedestrian = false) {
      const curve = new THREE.QuadraticBezierCurve3(p0, p1, p2);
      const points = curve.getPoints(14);
      const roadMat = isPedestrian ? matCobblePath : matAsphaltRoad;

      for (let i = 0; i < points.length - 1; i++) {
        const ptA = points[i];
        const ptB = points[i + 1];
        const segLen = ptA.distanceTo(ptB);
        const segGeo = new THREE.BoxGeometry(width, 0.18, segLen);
        const segMesh = new THREE.Mesh(segGeo, roadMat);
        segMesh.position.copy(ptA).lerp(ptB, 0.5);
        segMesh.lookAt(ptB);
        segMesh.receiveShadow = true;
        worldGroup.add(segMesh);

        // Curbs
        const kerbGeo = new THREE.BoxGeometry(0.20, 0.24, segLen);
        const kerbLeft = new THREE.Mesh(kerbGeo, matKerbStone);
        const kerbRight = new THREE.Mesh(kerbGeo, matKerbStone);
        kerbLeft.position.copy(segMesh.position);
        kerbRight.position.copy(segMesh.position);
        kerbLeft.rotation.copy(segMesh.rotation);
        kerbRight.rotation.copy(segMesh.rotation);
        kerbLeft.translateX(-width * 0.53);
        kerbRight.translateX(width * 0.53);
        kerbLeft.receiveShadow = true;
        kerbRight.receiveShadow = true;
        worldGroup.add(kerbLeft);
        worldGroup.add(kerbRight);
      }
    }

