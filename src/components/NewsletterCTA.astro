---
/**
 * NewsletterCTA.astro
 *
 * LinkedIn newsletter subscription block for AnyBody Can Design.
 * A self-contained, accessible CTA that adapts to the site's design system.
 *
 * Props:
 *   coverImage  — optional CMS-managed image path (e.g. /images/newsletter-cover.png)
 *   description — optional override description (falls back to the default)
 */

interface Props {
  coverImage?: string;
  description?: string;
}

const {
  coverImage,
  description = "A writing series about design — not as a profession, but as a way of seeing. Each piece explores an idea through observation, engineering, or lived experience. Published on LinkedIn.",
} = Astro.props;

const NEWSLETTER_URL =
  "https://www.linkedin.com/build-relation/newsletter-follow?entityUrn=7406658541127872513";
---

<aside class="newsletter-cta" aria-label="AnyBody Can Design newsletter">
  <div class="newsletter-inner">

    <!-- Cover / identity column -->
    <div class="newsletter-cover" aria-hidden="true">
      {coverImage ? (
        <img
          src={coverImage}
          alt=""
          class="newsletter-cover-img"
          width="200"
          height="200"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <!-- Intentional placeholder: monogram mark -->
        <div class="newsletter-cover-placeholder" aria-hidden="true">
          <span class="newsletter-monogram">ACD</span>
        </div>
      )}
    </div>

    <!-- Body column -->
    <div class="newsletter-body">
      <p class="newsletter-eyebrow">Newsletter</p>
      <h2 class="newsletter-title">AnyBody Can Design</h2>
      <p class="newsletter-description">{description}</p>

      <a
        href={NEWSLETTER_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="newsletter-btn"
        aria-label="Subscribe to AnyBody Can Design on LinkedIn (opens in new tab)"
      >
        <!-- LinkedIn logomark -->
        <svg
          class="newsletter-btn-icon"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          aria-hidden="true"
          fill="currentColor"
        >
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        Subscribe on LinkedIn
        <svg
          class="newsletter-btn-arrow"
          viewBox="0 0 16 16"
          width="12"
          height="12"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="3" y1="8" x2="13" y2="8"/>
          <polyline points="9 4 13 8 9 12"/>
        </svg>
      </a>
    </div>

  </div>
</aside>

<style>
  /* ── Wrapper ─────────────────────────────────────────────────────────── */
  .newsletter-cta {
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-xl);
    background: var(--colour-surface);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    max-width: 680px;
  }

  .newsletter-inner {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 0;
  }

  /* ── Cover ───────────────────────────────────────────────────────────── */
  .newsletter-cover {
    background: var(--colour-accent-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 160px;
    flex-shrink: 0;
  }

  .newsletter-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .newsletter-cover-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 160px;
  }

  .newsletter-monogram {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    color: var(--colour-accent);
    opacity: 0.8;
    user-select: none;
  }

  /* ── Body ────────────────────────────────────────────────────────────── */
  .newsletter-body {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-3);
  }

  .newsletter-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--colour-label);
    max-width: none;
    margin-bottom: 0;
  }

  .newsletter-title {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    color: var(--colour-fg);
    line-height: var(--leading-tight);
    margin: 0;
  }

  .newsletter-description {
    font-size: var(--text-sm);
    color: var(--colour-fg-muted);
    line-height: var(--leading-loose);
    max-width: 52ch;
    margin: 0;
  }

  /* ── Button ──────────────────────────────────────────────────────────── */
  .newsletter-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding: 0.5rem 1.125rem;
    background: #0A66C2;
    color: #ffffff;
    font-family: 'SF Pro Text', var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1;
    border-radius: 2rem;            /* pill shape matching LinkedIn's 16px radius at this size */
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition:
      background var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    align-self: flex-start;
    min-height: 44px;               /* touch target */
    white-space: nowrap;
  }

  .newsletter-btn:hover {
    background: #004182;
    box-shadow: 0 4px 12px hsl(210 90% 30% / 0.25);
    transform: translateY(-1px);
  }

  .newsletter-btn:active {
    transform: translateY(0);
    box-shadow: none;
  }

  .newsletter-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px #0A66C2, 0 0 0 5px var(--colour-bg);
  }

  .newsletter-btn-icon {
    flex-shrink: 0;
  }

  .newsletter-btn-arrow {
    flex-shrink: 0;
    opacity: 0.75;
    transition: transform var(--duration-fast) var(--ease-out), opacity var(--duration-fast);
  }

  .newsletter-btn:hover .newsletter-btn-arrow {
    transform: translateX(2px);
    opacity: 1;
  }

  /* ── Responsive ──────────────────────────────────────────────────────── */
  @media (max-width: 560px) {
    .newsletter-inner {
      grid-template-columns: 1fr;
    }

    .newsletter-cover {
      min-height: 100px;
      max-height: 100px;
    }

    .newsletter-body {
      padding: var(--space-6);
    }
  }

  /* ── Reduced motion ──────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .newsletter-btn,
    .newsletter-btn-arrow {
      transition: none;
    }
    .newsletter-btn:hover {
      transform: none;
    }
  }
</style>

