---
/**
 * Header — Global Navigation with Explore World Action & Adaptive Theme Toggle.
 * Features subtle destination accent indicators, keyboard navigation, and mobile responsiveness.
 */
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL;

const navLinks = [
  { label: 'Work',     href: `${base}work/`,     accent: '#f59e0b', id: 'lab' },
  { label: 'Research', href: `${base}research/`, accent: '#38bdf8', id: 'observatory' },
  { label: 'Studio',   href: `${base}studio/`,   accent: '#fb923c', id: 'foundry' },
  { label: 'Writing',  href: `${base}writing/`,  accent: '#34d399', id: 'writing' },
  { label: 'People',   href: `${base}people/`,   accent: '#a78bfa', id: 'commons' },
  { label: 'About',    href: `${base}about/`,    accent: '#f43f5e', id: 'outlook' },
];

const currentPath = Astro.url.pathname;
const isHome = currentPath === base || currentPath === `${base}/` || currentPath === '/';
---

<header class="site-header" role="banner">
  <div class="container">
    <div class="header-inner">
      <!-- Wordmark Logo -->
      <a href={base} class="site-logo" aria-label="Devashish Tambade — Home">
        <span class="logo-mark" aria-hidden="true">DT</span>
        <span class="logo-name">Devashish Tambade</span>
      </a>

      <!-- Desktop Primary Navigation -->
      <nav class="site-nav" id="site-nav" aria-label="Primary navigation">
        <ul class="nav-list" role="list">
          {navLinks.map((link) => {
            const isCurrent = currentPath === link.href || (link.href !== base && currentPath.startsWith(link.href));
            return (
              <li>
                <a
                  href={link.href}
                  class={`nav-link ${isCurrent ? 'is-active' : ''}`}
                  style={isCurrent ? `--link-accent: ${link.accent}` : undefined}
                  aria-current={isCurrent ? 'page' : undefined}
                >
                  <span class="nav-link-dot" aria-hidden="true" style={`background-color: ${link.accent}`}></span>
                  <span class="nav-link-label">{link.label}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <!-- Utility Actions (Explore World + Theme Toggle + Mobile Toggle) -->
      <div class="header-actions">
        <!-- Explore World Signature Button -->
        <a
          href={isHome ? "#miniature-world-3d" : `${base}#miniature-world-3d`}
          class="explore-world-btn"
          id="nav-explore-world"
          title="Explore the 3D Miniature Terrarium Diorama"
        >
          <span class="world-compass-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
            </svg>
          </span>
          <span class="world-btn-text">Explore World</span>
          <span class="world-btn-live-dot" aria-hidden="true"></span>
        </a>

        <!-- Zero-Flash Theme Toggle -->
        <ThemeToggle />

        <!-- Mobile Navigation Toggle -->
        <button
          class="nav-toggle"
          id="nav-toggle"
          aria-controls="site-nav"
          aria-expanded="false"
          aria-label="Toggle navigation"
          type="button"
        >
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Explore World Action Button */
  .explore-world-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 12px;
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.28);
    border-radius: var(--radius-full);
    color: var(--colour-fg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-out);
    white-space: nowrap;
    min-height: 32px;
  }

  .explore-world-btn:hover {
    background: rgba(245, 158, 11, 0.16);
    border-color: #f59e0b;
    color: var(--colour-fg);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.15);
  }

  .explore-world-btn:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .world-compass-icon {
    display: inline-flex;
    align-items: center;
    color: #f59e0b;
    line-height: 1;
  }

  .world-btn-live-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #f59e0b;
    box-shadow: 0 0 6px #f59e0b;
    animation: livePulse 2s infinite ease-in-out;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.3); }
  }

  /* Section Link Indicators */
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    position: relative;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nav-link-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.6);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .nav-link:hover .nav-link-dot {
    opacity: 0.7;
    transform: scale(1);
  }

  .nav-link.is-active {
    color: var(--colour-fg) !important;
    font-weight: 600;
  }

  .nav-link.is-active .nav-link-dot {
    opacity: 1;
    transform: scale(1.1);
    box-shadow: 0 0 6px var(--link-accent);
  }

  .nav-link.is-active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--link-accent);
    border-radius: 1px;
  }

  @media (max-width: 820px) {
    .world-btn-text {
      display: none;
    }
    .explore-world-btn {
      padding: 5px 8px;
    }
  }

  @media (max-width: 640px) {
    .header-actions {
      gap: var(--space-2);
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav    = document.getElementById('site-nav');

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      nav.classList.toggle('is-open', !expanded);
    });

    document.addEventListener('click', (e) => {
      if (!toggle.contains(e.target as Node) && !nav.contains(e.target as Node)) {
        toggle.setAttribute('aria-expanded', 'false');
        nav.classList.remove('is-open');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        toggle.setAttribute('aria-expanded', 'false');
        nav.classList.remove('is-open');
        toggle.focus();
      }
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        nav.classList.remove('is-open');
      });
    });
  }

  // Handle Explore World click when on homepage
  const exploreBtn = document.getElementById('nav-explore-world');
  if (exploreBtn) {
    exploreBtn.addEventListener('click', () => {
      // Dispatch campus world entry event if homepage script is listening
      window.dispatchEvent(new CustomEvent('enter-world-mode'));
    });
  }
</script>
