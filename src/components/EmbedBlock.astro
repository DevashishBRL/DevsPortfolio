---
/**
 * EmbedBlock.astro
 *
 * Safe, responsive, and privacy-conscious embed renderer for supported media:
 * - youtube: Responsive iframe with lazy-loading & fallback link
 * - vimeo: Responsive iframe with lazy-loading & fallback link
 * - image: Responsive image block with optional caption & link
 * - newsletter: Embedded newsletter CTA
 *
 * Strict security & privacy rules:
 * - Only approved provider URLs are parsed and embedded into vetted iframe sources.
 * - Raw HTML / script execution / arbitrary iframe URLs are explicitly disallowed.
 * - Lazy loading is enabled on external iframes/images.
 */
import NewsletterCTA from './NewsletterCTA.astro';

export interface EmbedData {
  type: 'youtube' | 'vimeo' | 'image' | 'newsletter';
  title?: string;
  url?: string;
  coverImage?: string;
  caption?: string;
}

interface Props {
  embed: EmbedData;
}

const { embed } = Astro.props;

/**
 * Validates and extracts a YouTube video ID.
 * Supports standard watch, youtu.be, embed, and shorts formats.
 */
function getYouTubeEmbedUrl(rawUrl?: string): string | null {
  if (!rawUrl) return null;
  try {
    const parsed = new URL(rawUrl);
    const hostname = parsed.hostname.replace(/^www\./, '');
    let videoId: string | null = null;

    if (hostname === 'youtube.com' || hostname === 'm.youtube.com') {
      if (parsed.pathname === '/watch') {
        videoId = parsed.searchParams.get('v');
      } else if (parsed.pathname.startsWith('/embed/')) {
        videoId = parsed.pathname.split('/')[2];
      } else if (parsed.pathname.startsWith('/shorts/')) {
        videoId = parsed.pathname.split('/')[2];
      }
    } else if (hostname === 'youtu.be') {
      videoId = parsed.pathname.slice(1).split('/')[0];
    }

    if (videoId && /^[\w-]{11}$/.test(videoId)) {
      return `https://www.youtube-nocookie.com/embed/${videoId}`;
    }
  } catch {
    return null;
  }
  return null;
}

/**
 * Validates and extracts a Vimeo video ID.
 * Supports standard vimeo.com/{id} and player.vimeo.com/video/{id}.
 */
function getVimeoEmbedUrl(rawUrl?: string): string | null {
  if (!rawUrl) return null;
  try {
    const parsed = new URL(rawUrl);
    const hostname = parsed.hostname.replace(/^www\./, '');
    let videoId: string | null = null;

    if (hostname === 'vimeo.com') {
      const match = parsed.pathname.match(/^\/(\d+)/);
      if (match) videoId = match[1];
    } else if (hostname === 'player.vimeo.com' && parsed.pathname.startsWith('/video/')) {
      const match = parsed.pathname.match(/^\/video\/(\d+)/);
      if (match) videoId = match[1];
    }

    if (videoId && /^\d+$/.test(videoId)) {
      return `https://player.vimeo.com/video/${videoId}?dnt=1`;
    }
  } catch {
    return null;
  }
  return null;
}

const ytEmbedSrc = embed.type === 'youtube' ? getYouTubeEmbedUrl(embed.url) : null;
const vimeoEmbedSrc = embed.type === 'vimeo' ? getVimeoEmbedUrl(embed.url) : null;
const isVideo = embed.type === 'youtube' || embed.type === 'vimeo';
const hasValidVideoSrc = ytEmbedSrc || vimeoEmbedSrc;
---

<div class="embed-block" data-embed-type={embed.type}>
  {embed.type === 'newsletter' && (
    <NewsletterCTA coverImage={embed.coverImage} description={embed.caption} />
  )}

  {embed.type === 'image' && (
    <figure class="embed-image-figure">
      {embed.url ? (
        <a href={embed.url} target="_blank" rel="noopener noreferrer" class="embed-image-link" aria-label={embed.title || 'View external image target'}>
          <img src={embed.coverImage || embed.url} alt={embed.title || ''} loading="lazy" decoding="async" class="embed-image" />
        </a>
      ) : (
        <img src={embed.coverImage} alt={embed.title || ''} loading="lazy" decoding="async" class="embed-image" />
      )}
      {embed.caption && <figcaption class="embed-caption">{embed.caption}</figcaption>}
    </figure>
  )}

  {isVideo && (
    <div class="embed-video-wrapper">
      {hasValidVideoSrc ? (
        <div class="embed-video-aspect">
          <iframe
            src={ytEmbedSrc || vimeoEmbedSrc || ''}
            title={embed.title || `${embed.type} video embed`}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            class="embed-iframe"
          ></iframe>
        </div>
      ) : (
        <div class="embed-fallback-card" role="alert">
          <p class="embed-fallback-text">
            <strong>Video unavailable:</strong> Unsupported or malformed URL.
          </p>
          {embed.url && (
            <a href={embed.url} target="_blank" rel="noopener noreferrer" class="embed-fallback-link">
              Open link in new tab &rarr;
            </a>
          )}
        </div>
      )}
      {embed.caption && <p class="embed-caption">{embed.caption}</p>}
    </div>
  )}
</div>

<style>
  .embed-block {
    margin-block: var(--space-8);
    width: 100%;
  }

  .embed-image-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .embed-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--colour-border-subtle);
    background: var(--colour-bg-subtle);
    display: block;
  }

  .embed-image-link {
    display: block;
    border-radius: var(--radius-lg);
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .embed-image-link:hover {
    opacity: 0.92;
  }

  .embed-video-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .embed-video-aspect {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
    background: var(--colour-bg-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--colour-border-subtle);
  }

  .embed-iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .embed-caption {
    font-size: var(--text-sm);
    color: var(--colour-fg-subtle);
    line-height: var(--leading-normal);
    font-style: italic;
    margin-top: var(--space-2);
    margin-bottom: 0;
  }

  .embed-fallback-card {
    padding: var(--space-4) var(--space-5);
    background: var(--colour-bg-subtle);
    border: 1px solid var(--colour-border);
    border-left: 3px solid var(--colour-accent);
    border-radius: var(--radius-md);
  }

  .embed-fallback-text {
    font-size: var(--text-sm);
    color: var(--colour-fg-muted);
    margin-bottom: var(--space-2);
  }

  .embed-fallback-link {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--colour-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>

