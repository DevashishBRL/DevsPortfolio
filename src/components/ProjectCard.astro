---
/**
 * ProjectCard.astro
 *
 * Premium, reusable exhibition card for Engineering & Robotics projects.
 * Supports:
 * - Direct Content Collection entry (`CollectionEntry<'projects'>`) or legacy `Project` model
 * - Category/Discipline badge with Amber Lab accents
 * - Clean status pills (Active, Ongoing Research, Completed)
 * - Tools and technology tags
 * - External repository/demo links and internal case study navigation
 * - Graceful visual fallback for missing cover images
 * - Full light/dark theme responsiveness
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
  featured?: boolean;
}

const { project, index = 0, featured = false } = Astro.props;
const { data, slug } = project;
const base = import.meta.env.BASE_URL;

const statusLabels: Record<string, string> = {
  active: 'Active Development',
  ongoing: 'Ongoing Research',
  completed: 'Completed Milestone',
};

const caseStudyHref = `${base}work/${slug}/`;
const displayStatus = statusLabels[data.status] || data.status;
---

<article
  class={`project-card ${featured ? 'is-featured' : ''}`}
  data-project-card
  data-title={data.title.toLowerCase()}
  data-description={data.description.toLowerCase()}
  data-tags={data.tags.join(' ').toLowerCase()}
  data-discipline={(data.discipline || '').toLowerCase()}
  data-status={data.status}
  style={`--card-idx: ${index}`}
>
  <div class="card-inner">
    <!-- Header: Status + Discipline -->
    <div class="card-meta-top">
      <div class={`status-pill status-pill--${data.status}`}>
        <span class="status-dot" aria-hidden="true"></span>
        <span class="status-text">{displayStatus}</span>
        {data.year && <span class="status-year">· {data.year}</span>}
      </div>

      {data.discipline && (
        <span class="discipline-badge">{data.discipline}</span>
      )}
    </div>

    <!-- Body: Title, Subtitle, Description -->
    <div class="card-body">
      <h3 class="card-title">
        <a href={caseStudyHref} class="card-title-link">
          {data.title}
        </a>
      </h3>
      <p class="card-subtitle">{data.subtitle}</p>
      <p class="card-description">{data.description}</p>
    </div>

    <!-- Tags & Tools -->
    <div class="card-tech-group">
      {data.tags && data.tags.length > 0 && (
        <div class="tags-cluster" aria-label="Domain topics">
          {data.tags.map(tag => (
            <span class="tech-tag">{tag}</span>
          ))}
        </div>
      )}

      {data.tools && data.tools.length > 0 && (
        <div class="tools-cluster" aria-label="Tools and methods">
          <span class="tools-label">Tools:</span>
          {data.tools.map(tool => (
            <span class="tool-chip">{tool}</span>
          ))}
        </div>
      )}
    </div>

    <!-- Footer Action Bar -->
    <div class="card-actions-bar">
      <a href={caseStudyHref} class="btn-case-study" aria-label={`Read case study for ${data.title}`}>
        <span>Read Case Study</span>
        <svg class="action-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      {data.externalUrl && (
        <a
          href={data.externalUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-external-link"
          aria-label={`External link for ${data.title}`}
          title="External Project Resource"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all var(--duration-fast) var(--ease-out);
    position: relative;
    overflow: hidden;
  }

  .project-card:hover {
    border-color: rgba(245, 158, 11, 0.45);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .project-card.is-featured {
    border-left: 3px solid #f59e0b;
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.03) 0%, var(--colour-surface) 100%);
  }

  .card-inner {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .status-pill--active,
  .status-pill--ongoing {
    color: #f59e0b;
  }

  .status-pill--completed {
    color: #10b981;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 6px currentColor;
  }

  .status-year {
    color: var(--colour-fg-subtle);
  }

  .discipline-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--colour-fg-muted);
    background: var(--colour-surface-2);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--colour-border-subtle);
    white-space: nowrap;
  }

  .card-body {
    margin-bottom: var(--space-5);
  }

  .card-title {
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: var(--leading-tight);
    margin-bottom: var(--space-1);
  }

  .card-title-link {
    color: var(--colour-fg);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .card-title-link:hover {
    color: #f59e0b;
  }

  .card-subtitle {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: #f59e0b;
    margin-bottom: var(--space-3);
  }

  .card-description {
    font-size: var(--text-sm);
    color: var(--colour-fg-muted);
    line-height: var(--leading-relaxed);
  }

  .card-tech-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--colour-border-subtle);
  }

  .tags-cluster {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tech-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 2px 7px;
    border-radius: 3px;
    background: var(--colour-surface-2);
    border: 1px solid var(--colour-border-subtle);
    color: var(--colour-fg-muted);
  }

  .tools-cluster {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .tools-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--colour-fg-subtle);
    text-transform: uppercase;
  }

  .tool-chip {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 1px 6px;
    border-radius: 2px;
    background: rgba(245, 158, 11, 0.08);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.20);
  }

  .card-actions-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .btn-case-study {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    color: #f59e0b;
    text-decoration: none;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.22);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .btn-case-study:hover {
    background: rgba(245, 158, 11, 0.18);
    border-color: rgba(245, 158, 11, 0.45);
    transform: translateX(2px);
  }

  .action-arrow {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .btn-case-study:hover .action-arrow {
    transform: translateX(3px);
  }

  .btn-external-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: var(--colour-surface-2);
    border: 1px solid var(--colour-border-subtle);
    color: var(--colour-fg-muted);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .btn-external-link:hover {
    color: var(--colour-fg);
    border-color: var(--colour-border);
    background: var(--colour-bg-raised);
  }
</style>
