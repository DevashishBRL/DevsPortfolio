---
/**
 * Footer — minimal footer with social links and legal copy.
 * All URLs are placeholder hashes — not invented.
 */

const year = new Date().getFullYear();

const socialLinks = [
  { label: 'GitHub',   href: '#github-placeholder',   icon: 'github' },
  { label: 'LinkedIn', href: '#linkedin-placeholder', icon: 'linkedin' },
  { label: 'CV',       href: '#cv-placeholder',       icon: 'document' },
  { label: 'Contact',  href: '#contact-placeholder',  icon: 'mail' },
];
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-inner">
      <!-- Brand -->
      <div class="footer-brand">
        <p class="footer-name">Devashish Tambade</p>
        <p class="footer-tagline">
          Robotics Engineer · Research Technologist · Builder
        </p>
      </div>

      <!-- Links -->
      <div class="footer-links">
        <nav class="footer-social" aria-label="Social and contact links">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              class="social-link"
              aria-label={link.label}
              rel="noopener noreferrer"
            >
              {/* Inline SVG icons */}
              {link.icon === 'github' && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
                </svg>
              )}
              {link.icon === 'linkedin' && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                  <rect x="2" y="9" width="4" height="12"/>
                  <circle cx="4" cy="4" r="2"/>
                </svg>
              )}
              {link.icon === 'document' && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                  <polyline points="10 9 9 9 8 9"/>
                </svg>
              )}
              {link.icon === 'mail' && (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              )}
              <span>{link.label}</span>
            </a>
          ))}
        </nav>

        <p class="footer-legal">
          &copy; {year} Devashish Tambade. All rights reserved.
        </p>
      </div>
    </div>
  </div>
</footer>
