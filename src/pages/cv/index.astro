---
/**
 * /cv/ — Dedicated Curriculum Vitae View & Overview
 * Color identity: ROSE / CRIMSON (#f43f5e / var(--accent-about))
 */
import PageLayout from '../../layouts/PageLayout.astro';
import { workHistory, researchAreas, engineeringProjects } from '../../data/content';
import { getEntry } from 'astro:content';

const base = import.meta.env.BASE_URL;

// Read profile for verified coordinates
const profileEntry = await getEntry('site', 'profile');
const profile = profileEntry?.data;
---

<PageLayout
  title="CV — Devashish Tambade"
  description="Curriculum vitae and professional background for Devashish Tambade — robotics engineer, research technologist and product builder."
  label="06 / CURRICULUM VITAE"
  heading="Curriculum Vitae"
  subheading="MEng Robotics Engineering · University of Bristol · KLA Interactives"
>
  <div class="cv-page-container">
    <!-- District Identity Banner -->
    <div class="district-badge-row">
      <div class="district-badge-pill">
        <span class="badge-dot" aria-hidden="true"></span>
        <span>DISTRICT 06 // THE OUTLOOK</span>
      </div>
      <div class="cv-nav-actions">
        <a href={`${base}about/`} class="cv-back-link">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>Return to About</span>
        </a>
        <a href={`${base}#miniature-world-3d`} class="district-world-link" title="View in 3D Miniature Terrarium">
          <span>Locate in World</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
          </svg>
        </a>
      </div>
    </div>

    <!-- PDF Download Notice -->
    <section class="cv-notice-section" aria-labelledby="cv-notice-heading">
      <div class="cv-notice-card">
        <div class="cv-notice-text-block">
          <span class="notice-tag">DOCUMENTATION STATUS</span>
          <h2 class="cv-notice-title" id="cv-notice-heading">Structured Web Curriculum Vitae</h2>
          <p class="cv-notice-desc">
            This digital record contains complete verified details of engineering appointments, academic training, and research projects. A downloadable PDF version will be linked here once a current signed document is uploaded.
          </p>
        </div>
        <div class="cv-placeholder-badge" role="note" aria-label="PDF coming soon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
          </svg>
          <span>PDF Download Coming Soon</span>
        </div>
      </div>
    </section>

    <!-- Education & Academic Foundation -->
    <section class="cv-block-section" aria-labelledby="cv-edu-heading">
      <div class="section-heading-bar">
        <h2 class="section-title" id="cv-edu-heading">Education</h2>
      </div>

      <div class="cv-entries-list">
        <div class="cv-entry-row">
          <div class="cv-entry-meta">
            <span class="cv-period">2022 — Present</span>
            <span class="cv-current-tag">Current</span>
          </div>
          <div class="cv-entry-body">
            <h3 class="cv-entry-role">MEng Robotics Engineering</h3>
            <p class="cv-entry-org">University of Bristol · Bristol, UK</p>
            <p class="cv-entry-desc">
              Integrated master's programme in robotics engineering. Core study areas include mechatronics, embedded systems, control theory, human-robot interaction and engineering design methodology.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Work & Appointments -->
    <section class="cv-block-section" aria-labelledby="cv-work-heading">
      <div class="section-heading-bar">
        <h2 class="section-title" id="cv-work-heading">Professional & Research Experience</h2>
      </div>

      <div class="cv-entries-list">
        {workHistory.map(entry => (
          <div class="cv-entry-row">
            <div class="cv-entry-meta">
              <span class="cv-period">{entry.period}</span>
              {entry.current && <span class="cv-current-tag">Current</span>}
              {entry.location && <span class="cv-loc">{entry.location}</span>}
            </div>
            <div class="cv-entry-body">
              <h3 class="cv-entry-role">{entry.role}</h3>
              <p class="cv-entry-org">{entry.organisation}</p>
              <p class="cv-entry-desc">{entry.description}</p>
              {entry.highlights && (
                <ul class="cv-bullet-list">
                  {entry.highlights.map(h => <li>{h}</li>)}
                </ul>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Technical Projects -->
    <section class="cv-block-section" aria-labelledby="cv-proj-heading">
      <div class="section-heading-bar">
        <h2 class="section-title" id="cv-proj-heading">Selected Technical Projects</h2>
      </div>

      <div class="cv-entries-list">
        {engineeringProjects.map(proj => (
          <div class="cv-entry-row">
            <div class="cv-entry-meta">
              <span class="cv-period">{proj.status}</span>
            </div>
            <div class="cv-entry-body">
              <h3 class="cv-entry-role">{proj.title}</h3>
              <p class="cv-entry-org">{proj.subtitle}</p>
              <p class="cv-entry-desc">{proj.description}</p>
              {proj.tags && (
                <div class="cv-tags-row">
                  {proj.tags.map(t => <span class="cv-mini-tag">{t}</span>)}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Research Vectors -->
    <section class="cv-block-section" aria-labelledby="cv-res-heading">
      <div class="section-heading-bar">
        <h2 class="section-title" id="cv-res-heading">Active Research Vectors</h2>
      </div>

      <div class="cv-entries-list">
        {researchAreas.map(area => (
          <div class="cv-entry-row">
            <div class="cv-entry-meta">
              <span class="cv-period">{area.status}</span>
            </div>
            <div class="cv-entry-body">
              <h3 class="cv-entry-role">{area.title}</h3>
              <p class="cv-entry-desc">{area.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .cv-page-container {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block-end: var(--space-20);
  }

  .district-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-3);
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--colour-border-subtle);
  }

  .district-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(244, 63, 94, 0.08);
    border: 1px solid rgba(244, 63, 94, 0.25);
    color: var(--accent-about, #f43f5e);
    padding: 4px 12px;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-about, #f43f5e);
    box-shadow: 0 0 8px rgba(244, 63, 94, 0.8);
  }

  .cv-nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .cv-back-link,
  .district-world-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--colour-fg-muted);
    text-decoration: none;
    padding: 3px 10px;
    border-radius: 9999px;
    border: 1px solid var(--colour-border-subtle);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .cv-back-link:hover,
  .district-world-link:hover {
    color: var(--accent-about, #f43f5e);
    border-color: rgba(244, 63, 94, 0.4);
    background: rgba(244, 63, 94, 0.06);
    transform: translateY(-1px);
  }

  .cv-notice-section {
    margin-bottom: var(--space-12);
  }

  .cv-notice-card {
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-left: 4px solid var(--accent-about, #f43f5e);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-8);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .notice-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--accent-about, #f43f5e);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 2px;
  }

  .cv-notice-title {
    font-size: var(--text-lg);
    font-weight: 700;
    margin: 0 0 var(--space-2) 0;
  }

  .cv-notice-desc {
    font-size: var(--text-xs);
    color: var(--colour-fg-muted);
    line-height: var(--leading-relaxed);
    max-width: 60ch;
    margin: 0;
  }

  .cv-placeholder-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: var(--colour-surface-elevated, rgba(0, 0, 0, 0.03));
    border: 1px dashed var(--colour-border);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--colour-fg-subtle);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .cv-block-section {
    margin-bottom: var(--space-12);
  }

  .section-heading-bar {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--colour-border-subtle);
    margin-bottom: var(--space-6);
  }

  .section-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--colour-fg);
  }

  .cv-entries-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .cv-entry-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-6);
    padding: var(--space-4) var(--space-6);
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  .cv-entry-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cv-period {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--colour-fg);
  }

  .cv-current-tag {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    color: #10b981;
    text-transform: uppercase;
  }

  .cv-loc {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--colour-fg-subtle);
  }

  .cv-entry-role {
    font-size: var(--text-md);
    font-weight: 700;
    margin: 0 0 2px 0;
  }

  .cv-entry-org {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-about, #f43f5e);
    margin: 0 0 var(--space-2) 0;
  }

  .cv-entry-desc {
    font-size: var(--text-xs);
    color: var(--colour-fg-muted);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-3) 0;
  }

  .cv-bullet-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cv-bullet-list li {
    font-size: 11px;
    color: var(--colour-fg-muted);
    position: relative;
    padding-left: 12px;
  }

  .cv-bullet-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent-about, #f43f5e);
  }

  .cv-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .cv-mini-tag {
    font-family: var(--font-mono);
    font-size: 9px;
    padding: 1px 6px;
    border-radius: 3px;
    background: var(--colour-surface-elevated, rgba(0, 0, 0, 0.04));
    border: 1px solid var(--colour-border-subtle);
    color: var(--colour-fg-subtle);
  }

  @media (max-width: 640px) {
    .cv-notice-card {
      flex-direction: column;
      align-items: flex-start;
    }
    .cv-entry-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
