---
/**
 * /about/ — Professional CV Experience & Multidisciplinary Profile
 * Color identity: ROSE / CRIMSON (#f43f5e / var(--accent-about))
 * Personality: Multidisciplinary integrator, intellectual curiosity, adaptability,
 * systems thinking, execution across hardware, software and communities.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { workHistory, researchAreas, communityActivities } from '../../data/content';

const base = import.meta.env.BASE_URL;

// Live profile from CMS site collection
const profileEntry = await getEntry('site', 'profile');
const profile = profileEntry?.data;

// Live projects from CMS for dynamic "Selected Work" showcase
const allProjects = await getCollection('projects');
const featuredProjects = allProjects.filter(p => p.data.featured).slice(0, 3);
const allProducts = await getCollection('products');

// Structured capability domains (no arbitrary percentage bars)
const capabilityDomains = [
  {
    domain: 'Mechatronics & Hardware',
    skills: ['Kinematic Linkage Design', 'SolidWorks / Fusion 360', 'Rapid Prototyping (FDM/SLA)', 'Enclosure Engineering', 'Biocompatible Material Evaluation'],
  },
  {
    domain: 'Embedded Systems & IoT',
    skills: ['C/C++ & Python Firmware', 'Raspberry Pi / Microcontroller Integration', 'Sensor Telemetry Loops', 'Circuit Prototyping', 'Serial & Wireless Protocols'],
  },
  {
    domain: 'Software Architecture & Product',
    skills: ['TypeScript / Modern Web', 'System Architecture', 'Information Architecture', 'Human-Centred Interaction Design', 'Full-Lifecycle Product Scoping'],
  },
  {
    domain: 'Research & Collaboration',
    skills: ['Hypothesis Formulation', 'Iterative Rig Testing', 'Technical Documentation', 'Peer Mentorship', 'Design Thinking Facilitation'],
  },
];
---

<PageLayout
  title="About — Professional Profile & The Outlook"
  description="Curriculum vitae and professional profile of Devashish Tambade — robotics engineer, research technologist and multidisciplinary builder."
  label="06 / THE OUTLOOK"
  heading="Devashish Tambade"
  subheading="Robotics Engineer · Research Technologist · Product Builder"
>
  <div class="cv-experience">
    <!-- District Identity Banner -->
    <div class="district-badge-row">
      <div class="district-badge-pill">
        <span class="badge-dot" aria-hidden="true"></span>
        <span>DISTRICT 06 // THE OUTLOOK</span>
      </div>
      <div class="district-actions">
        <a href={`${base}#miniature-world-3d`} class="district-world-link" title="View The Outlook in 3D Miniature Terrarium">
          <span>Locate in World</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
          </svg>
        </a>
      </div>
    </div>

    <!-- 1. Introduction & Multidisciplinary Identity -->
    <section class="cv-intro-section" aria-labelledby="cv-intro-heading">
      <div class="identity-card">
        <div class="identity-grid">
          <div class="identity-narrative">
            <span class="identity-kicker">MULTIDISCIPLINARY BUILDER</span>
            <h2 class="identity-lead" id="cv-intro-heading">
              Engineering solutions at the intersection of mechanical hardware, firmware, and human-centred design.
            </h2>
            <p class="identity-body">
              {profile?.bio || "I am a robotics engineer and research technologist who thrives across interdisciplinary boundaries. Rather than confining myself to a narrow silo, I integrate mechanical mechatronics, embedded sensory telemetry, and thoughtful software tools to turn complex problems into tangible, testable outcomes."}
            </p>
            <p class="identity-subtext">
              My work spans accessible biomechatronic prosthetics at the University of Bristol, wearable medical enclosure engineering, telemetry interfaces for agriculture, and independent tools for thought at KLA Interactives.
            </p>
            
            <blockquote class="identity-quote">
              <p>"{profile?.tagline || 'I build things that make problems smaller.'}"</p>
              <cite>— Thoughtfully Brilliant. Extraordinarily Simple.</cite>
            </blockquote>
          </div>

          <aside class="identity-summary-panel">
            <h3 class="panel-heading">Core Coordinates</h3>
            <dl class="summary-list">
              <div class="summary-row">
                <dt>Current Focus</dt>
                <dd>{profile?.statusNotice || 'MEng Robotics Engineering · University of Bristol'}</dd>
              </div>
              <div class="summary-row">
                <dt>Primary Domains</dt>
                <dd>Biomechatronics, Embedded Telemetry, Human-Robot Systems</dd>
              </div>
              <div class="summary-row">
                <dt>Product Studio</dt>
                <dd>Founder, KLA Interactives</dd>
              </div>
              <div class="summary-row">
                <dt>Location</dt>
                <dd>{profile?.location || 'Bristol, United Kingdom'}</dd>
              </div>
              <div class="summary-row">
                <dt>CV Status</dt>
                <dd class="cv-status-note">
                  <span class="status-indicator">◈</span> Structured format below
                </dd>
              </div>
            </dl>
          </aside>
        </div>
      </div>
    </section>

    <!-- 2. Multidisciplinary Practice Areas -->
    <section class="disciplines-section" aria-labelledby="disciplines-heading">
      <h2 class="section-title" id="disciplines-heading">Multidisciplinary Practice Areas</h2>
      <div class="disciplines-grid">
        <div class="discipline-card">
          <span class="discipline-tagline">HARDWARE</span>
          <h3 class="discipline-name">Physical Mechatronics</h3>
          <p class="discipline-desc">
            Kinematics, ergonomic enclosures, tactile physical prototypes, and assistive mechanisms built for the unpredictability of human contact.
          </p>
        </div>

        <div class="discipline-card">
          <span class="discipline-tagline">FIRMWARE & IOT</span>
          <h3 class="discipline-name">Embedded Telemetry</h3>
          <p class="discipline-desc">
            Sensor integration, real-time data processing, low-power telemetry, and translation of raw sensor streams into actionable operator insights.
          </p>
        </div>

        <div class="discipline-card">
          <span class="discipline-tagline">THOUGHT TOOLS</span>
          <h3 class="discipline-name">Software & Cognition</h3>
          <p class="discipline-desc">
            Digital tools designed to map thoughts spatially, streamline technical drafting, and reduce cognitive anxiety in complex workflows.
          </p>
        </div>

        <div class="discipline-card">
          <span class="discipline-tagline">COMMUNITY</span>
          <h3 class="discipline-name">Mentorship & Teaching</h3>
          <p class="discipline-desc">
            Facilitating design thinking workshops, peer engineering mentorship, and fostering inclusive, question-friendly technical learning environments.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. Chronological Professional & Research Timeline -->
    <section class="timeline-section" aria-labelledby="timeline-heading">
      <div class="section-heading-bar">
        <h2 class="section-title" id="timeline-heading">Experience & Roles</h2>
      </div>

      <div class="cv-timeline">
        {workHistory.map((item) => (
          <article class="timeline-row">
            <div class="timeline-meta">
              <span class="timeline-period">{item.period}</span>
              {item.current && <span class="current-indicator">Current</span>}
              {item.location && <span class="timeline-location">{item.location}</span>}
            </div>

            <div class="timeline-content">
              <h3 class="timeline-role">{item.role}</h3>
              <p class="timeline-org">{item.organisation}</p>
              <p class="timeline-desc">{item.description}</p>

              {item.highlights && item.highlights.length > 0 && (
                <ul class="timeline-highlights">
                  {item.highlights.map(h => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}

              {item.tags && item.tags.length > 0 && (
                <ul class="timeline-tags">
                  {item.tags.map(t => (
                    <li class="cv-tag">{t}</li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 4. Selected Live CMS Projects -->
    <section class="selected-projects-section" aria-labelledby="selected-work-heading">
      <div class="section-heading-bar">
        <h2 class="section-title" id="selected-work-heading">Selected Technical Work</h2>
        <a href={`${base}work/`} class="all-link">View Full Work Gallery →</a>
      </div>

      <div class="selected-grid">
        {featuredProjects.map(proj => (
          <div class="selected-card">
            <div class="selected-card-top">
              <span class="selected-discipline">{proj.data.discipline || 'Engineering'}</span>
              <span class="selected-status">{proj.data.status}</span>
            </div>
            <h3 class="selected-title">
              <a href={`${base}work/${proj.slug}/`} class="selected-link">
                {proj.data.title}
              </a>
            </h3>
            <p class="selected-desc">{proj.data.description}</p>
            <a href={`${base}work/${proj.slug}/`} class="read-link">Read Case Study →</a>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. Structured Capabilities & Skills -->
    <section class="capabilities-section" aria-labelledby="capabilities-heading">
      <div class="section-heading-bar">
        <h2 class="section-title" id="capabilities-heading">Capabilities & Technical Methods</h2>
      </div>

      <div class="capabilities-grid">
        {capabilityDomains.map(group => (
          <div class="capability-group-card">
            <h3 class="capability-domain-title">{group.domain}</h3>
            <ul class="capability-list">
              {group.skills.map(s => (
                <li class="capability-item">
                  <span class="check-bullet" aria-hidden="true">✓</span>
                  <span>{s}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- 6. Education -->
    <section class="education-section" aria-labelledby="education-heading">
      <div class="section-heading-bar">
        <h2 class="section-title" id="education-heading">Education & Development</h2>
      </div>

      <div class="education-card">
        <div class="edu-header">
          <div>
            <h3 class="edu-degree">MEng Robotics Engineering</h3>
            <p class="edu-school">University of Bristol</p>
          </div>
          <span class="edu-period">2022 — Present</span>
        </div>
        <p class="edu-desc">
          Rigorous engineering training covering classical and modern robotics, kinematics and dynamics, embedded systems, linear control systems, biomechatronics, and independent research project scoping.
        </p>
      </div>
    </section>

    <!-- 7. Explore the World Ecosystem Nav -->
    <section class="world-nav-section" aria-labelledby="world-nav-heading">
      <div class="section-heading-bar">
        <h2 class="section-title" id="world-nav-heading">Explore the Miniature World Districts</h2>
        <span class="heading-count">5 Districts</span>
      </div>

      <nav class="world-nav-grid" aria-label="Portfolio districts navigation">
        <a href={`${base}work/`} class="district-nav-card district-nav-card--work">
          <span class="nav-district-num">01</span>
          <span class="nav-district-name">The Lab</span>
          <span class="nav-district-sub">Engineering & Hardware</span>
        </a>
        <a href={`${base}research/`} class="district-nav-card district-nav-card--research">
          <span class="nav-district-num">02</span>
          <span class="nav-district-name">The Observatory</span>
          <span class="nav-district-sub">Systems Investigation</span>
        </a>
        <a href={`${base}studio/`} class="district-nav-card district-nav-card--studio">
          <span class="nav-district-num">03</span>
          <span class="nav-district-name">The Foundry</span>
          <span class="nav-district-sub">KLA Digital Tools</span>
        </a>
        <a href={`${base}writing/`} class="district-nav-card district-nav-card--writing">
          <span class="nav-district-num">04</span>
          <span class="nav-district-name">AnyBody Can Design</span>
          <span class="nav-district-sub">Essays & Perspectives</span>
        </a>
        <a href={`${base}people/`} class="district-nav-card district-nav-card--people">
          <span class="nav-district-num">05</span>
          <span class="nav-district-name">The Commons</span>
          <span class="nav-district-sub">Community & Mentoring</span>
        </a>
      </nav>
    </section>

    <!-- 8. Contact & Collaboration -->
    <section class="contact-section" id="contact" aria-labelledby="contact-heading">
      <div class="contact-card">
        <span class="contact-label">COLLABORATION & ENQUIRIES</span>
        <h2 class="contact-lead" id="contact-heading">Interested in collaborating or discussing opportunities?</h2>
        <p class="contact-body">
          Whether you are looking to discuss research vectors in assistive hardware, need technical systems prototyping, or are interested in what we are building at KLA Interactives, I welcome thoughtful conversations.
        </p>
        <div class="contact-actions">
          <a href="mailto:ka24911@bristol.ac.uk" class="contact-btn">Get in Touch via Email</a>
          <a href={`${base}cv/`} class="contact-btn contact-btn--subtle">View Dedicated CV View</a>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .cv-experience {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block-end: var(--space-20);
  }

  .district-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-3);
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--colour-border-subtle);
  }

  .district-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(244, 63, 94, 0.08);
    border: 1px solid rgba(244, 63, 94, 0.25);
    color: var(--accent-about, #f43f5e);
    padding: 4px 12px;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-about, #f43f5e);
    box-shadow: 0 0 8px rgba(244, 63, 94, 0.8);
  }

  .district-world-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--colour-fg-muted);
    text-decoration: none;
    padding: 3px 10px;
    border-radius: 9999px;
    border: 1px solid var(--colour-border-subtle);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .district-world-link:hover {
    color: var(--accent-about, #f43f5e);
    border-color: rgba(244, 63, 94, 0.4);
    background: rgba(244, 63, 94, 0.06);
    transform: translateY(-1px);
  }

  .cv-intro-section {
    margin-bottom: var(--space-16);
  }

  .identity-card {
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-left: 4px solid var(--accent-about, #f43f5e);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-sm);
  }

  .identity-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .identity-kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--accent-about, #f43f5e);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: var(--space-2);
  }

  .identity-lead {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--colour-fg);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-4);
  }

  .identity-body {
    font-size: var(--text-base);
    color: var(--colour-fg-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .identity-subtext {
    font-size: var(--text-sm);
    color: var(--colour-fg-subtle);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .identity-quote {
    padding: var(--space-3) var(--space-4);
    background: rgba(244, 63, 94, 0.04);
    border-left: 2px solid var(--accent-about, #f43f5e);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin: var(--space-4) 0 0 0;
  }

  .identity-quote p {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--colour-fg);
    margin: 0 0 2px 0;
  }

  .identity-quote cite {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent-about, #f43f5e);
    font-style: normal;
  }

  .identity-summary-panel {
    background: var(--colour-surface-elevated, rgba(0, 0, 0, 0.02));
    border: 1px solid var(--colour-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }

  .panel-heading {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--accent-about, #f43f5e);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
    text-transform: uppercase;
  }

  .summary-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
  }

  .summary-row dt {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--colour-fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2px;
  }

  .summary-row dd {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--colour-fg);
    margin: 0;
  }

  .cv-status-note {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--colour-fg-muted);
  }

  .status-indicator {
    color: var(--accent-about, #f43f5e);
    font-size: 10px;
  }

  .disciplines-section {
    margin-bottom: var(--space-16);
  }

  .section-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--colour-fg);
    margin-bottom: var(--space-6);
  }

  .disciplines-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-6);
  }

  .discipline-card {
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .discipline-tagline {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--accent-about, #f43f5e);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: var(--space-2);
  }

  .discipline-name {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--colour-fg);
    margin-bottom: var(--space-2);
  }

  .discipline-desc {
    font-size: var(--text-xs);
    color: var(--colour-fg-muted);
    line-height: var(--leading-relaxed);
  }

  .timeline-section {
    margin-bottom: var(--space-16);
  }

  .section-heading-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--colour-border-subtle);
    margin-bottom: var(--space-8);
  }

  .all-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-about, #f43f5e);
    text-decoration: none;
  }

  .all-link:hover {
    text-decoration: underline;
  }

  .cv-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .timeline-row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: var(--space-8);
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .timeline-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .timeline-period {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--colour-fg);
  }

  .current-indicator {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: #10b981;
    text-transform: uppercase;
  }

  .timeline-location {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--colour-fg-subtle);
  }

  .timeline-role {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--colour-fg);
    margin-bottom: 2px;
  }

  .timeline-org {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-about, #f43f5e);
    margin-bottom: var(--space-3);
  }

  .timeline-desc {
    font-size: var(--text-sm);
    color: var(--colour-fg-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .timeline-highlights {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4) 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .timeline-highlights li {
    font-size: var(--text-xs);
    color: var(--colour-fg-muted);
    position: relative;
    padding-left: 14px;
  }

  .timeline-highlights li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent-about, #f43f5e);
  }

  .timeline-tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .cv-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 2px 7px;
    border-radius: 4px;
    background: var(--colour-surface-elevated, rgba(0, 0, 0, 0.04));
    border: 1px solid var(--colour-border-subtle);
    color: var(--colour-fg-muted);
  }

  .selected-projects-section {
    margin-bottom: var(--space-16);
  }

  .selected-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  .selected-card {
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-sm);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .selected-card:hover {
    border-color: rgba(244, 63, 94, 0.45);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .selected-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .selected-discipline {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent-about, #f43f5e);
  }

  .selected-status {
    font-family: var(--font-mono);
