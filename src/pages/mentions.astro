---
/**
 * Mentions page — In the Wild, external publications and features.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { externalMentions } from '../data/content';

const hasReal = !(externalMentions.length === 1 && externalMentions[0].id === 'placeholder-mention-1');
---

<BaseLayout
  title="In the Wild — External Mentions"
  description="External publications, articles, interviews and mentions featuring Devashish Tambade."
>
  <section class="hero" style="padding-block-end: var(--space-12);" aria-labelledby="wild-heading">
    <div class="container">
      <div class="hero-inner">
        <p class="hero-label">External</p>
        <h1 class="hero-heading" id="wild-heading" style="font-size: var(--text-3xl);">
          In the Wild
        </h1>
        <p class="hero-body">
          External publications, articles, interviews and other mentions featuring Devashish or his work.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-label="All external mentions">
    <div class="container">
      {hasReal ? (
        <div class="card-grid" role="list">
          {externalMentions.map((mention) => (
            <div role="listitem">
              <article class="mention-card">
                <div class="mention-body">
                  <p class="mention-type">{mention.type}</p>
                  <p class="mention-pub">{mention.publication}</p>
                  <p class="mention-title">{mention.title}</p>
                  <p class="mention-desc">{mention.description}</p>
                </div>
              </article>
            </div>
          ))}
        </div>
      ) : (
        <p class="mention-placeholder">
          External mentions and publications will appear here as they are added.
        </p>
      )}
    </div>
  </section>
</BaseLayout>
