---
/**
 * /work/ — The Lab: Engineering & Robotics Exhibition
 * Identity: Amber (#f59e0b)
 * Personality: Precision, mechanical systems, experimentation, and tangible engineering.
 * Single Source of Truth: Pulls directly from Astro Content Collections ('projects') managed via Pages CMS.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const base = import.meta.env.BASE_URL;

// Live project collection from CMS
const allProjects = await getCollection('projects');

// Featured project: highest priority / featured flag
const featuredProject = allProjects.find(p => p.data.featured && p.data.status !== 'completed') || allProjects[0];

// Sort: featured first, then year descending
const sortedProjects = [...allProjects].sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return (b.data.year ?? 0) - (a.data.year ?? 0);
});

// Category definitions inferred from tags/disciplines
const categories = [
  { id: 'all', label: 'All Projects' },
  { id: 'robotics', label: 'Robotics' },
  { id: 'mechanical', label: 'Mechanical Engineering' },
  { id: 'embedded', label: 'Embedded Systems' },
  { id: 'medical', label: 'Medical & Assistive' },
];
---

<PageLayout
  title="Work — The Lab: Engineering & Robotics"
  description="Exhibition of physical mechatronics, accessible prosthetics research, medical device enclosures, and embedded IoT telemetry by Devashish Tambade."
  label="01 — THE LAB"
  heading="Things I've built. Problems I've explored."
  subheading="A multidisciplinary engineering laboratory combining mechanical mechatronics, embedded sensory telemetry, rapid functional prototyping, and human-centred design."
>
  <div class="lab-experience">
    <!-- District Marker & Spatial Coordinates -->
    <div class="district-badge-row">
      <div class="district-badge-pill">
        <span class="badge-dot" aria-hidden="true"></span>
        <span>THE LAB // MECHATRONICS HIGH-BAY</span>
      </div>
      <div class="district-controls">
        <a href={`${base}#miniature-world-3d`} class="world-link-chip" title="View The Lab in the 3D Miniature Terrarium">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
          </svg>
          <span>Locate in World</span>
        </a>
        <span class="archive-count">{allProjects.length} Verified Entries</span>
      </div>
    </div>

    <!-- Section A: Featured Engineering Exhibit -->
    {featuredProject && (
      <section class="featured-exhibit-section" aria-labelledby="featured-heading">
        <div class="featured-card">
          <div class="featured-badge-bar">
            <span class="featured-kicker">FEATURED ENGINEERING INITIATIVE</span>
            <span class="featured-status">{featuredProject.data.status === 'active' ? 'Active Prototyping' : 'Completed Milestone'}</span>
          </div>

          <div class="featured-content-grid">
            <div class="featured-narrative">
              <h2 class="featured-title" id="featured-heading">
                <a href={`${base}work/${featuredProject.slug}/`} class="featured-title-link">
                  {featuredProject.data.title}
                </a>
              </h2>
              <p class="featured-subtitle">{featuredProject.data.subtitle}</p>
              <p class="featured-desc">{featuredProject.data.description}</p>

              {featuredProject.data.tags && (
                <div class="featured-tags-cluster">
                  {featuredProject.data.tags.map(t => (
                    <span class="featured-tag">{t}</span>
                  ))}
                </div>
              )}

              <div class="featured-action-row">
                <a href={`${base}work/${featuredProject.slug}/`} class="btn-featured-primary">
                  <span>Explore Full Case Study</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
                {featuredProject.data.externalUrl && (
                  <a href={featuredProject.data.externalUrl} target="_blank" rel="noopener noreferrer" class="btn-featured-secondary">
                    <span>External Repo</span>
                  </a>
                )}
              </div>
            </div>

            <div class="featured-specs-panel">
              <h3 class="specs-title">Engineering Parameters</h3>
              <dl class="specs-list">
                {featuredProject.data.discipline && (
                  <div class="spec-row">
                    <dt>Discipline</dt>
                    <dd>{featuredProject.data.discipline}</dd>
                  </div>
                )}
                {featuredProject.data.year && (
                  <div class="spec-row">
                    <dt>Timeline</dt>
                    <dd>{featuredProject.data.year}</dd>
                  </div>
                )}
                {featuredProject.data.tools && featuredProject.data.tools.length > 0 && (
                  <div class="spec-row">
                    <dt>Key Tools</dt>
                    <dd>{featuredProject.data.tools.join(', ')}</dd>
                  </div>
                )}
                {featuredProject.data.keySkills && featuredProject.data.keySkills.length > 0 && (
                  <div class="spec-row">
                    <dt>Core Methods</dt>
                    <dd>{featuredProject.data.keySkills.slice(0, 3).join(', ')}</dd>
                  </div>
                )}
              </dl>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Section B & C: Project Discovery (Filters + Live Search) -->
    <section class="project-discovery-section" aria-labelledby="discovery-heading">
      <div class="discovery-header-bar">
        <div>
          <h2 class="discovery-heading" id="discovery-heading">Engineering Archive</h2>
          <p class="discovery-sub">Filter by technical discipline or search by technology keyword.</p>
        </div>

        <!-- Search Input -->
        <div class="search-wrap">
          <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            id="lab-project-search"
            class="lab-search-input"
            placeholder="Search robotics, kinematics, IoT..."
            aria-label="Search engineering projects"
          />
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="category-filter-strip" role="tablist" aria-label="Project category filter">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class={`filter-pill ${idx === 0 ? 'is-active' : ''}`}
            data-filter={cat.id}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            {cat.label}
          </button>
        ))}
        <button type="button" class="reset-filter-btn" id="reset-filter-btn" style="display: none;">
          Reset Filters
        </button>
      </div>

      <!-- Dynamic Project Exhibition Grid -->
      <div class="projects-grid" id="projects-grid">
        {sortedProjects.map((project, idx) => (
          <ProjectCard project={project} index={idx} />
        ))}
      </div>

      <!-- Empty State -->
      <div class="projects-empty-state" id="projects-empty-state" style="display: none;">
        <div class="empty-icon-wrap" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <h3 class="empty-title">No matching engineering projects found</h3>
        <p class="empty-desc">Try clearing your search query or selecting "All Projects" to view the complete laboratory archive.</p>
        <button type="button" class="btn-clear-search" id="btn-clear-search">
          Show All Projects
        </button>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .lab-experience {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block-end: var(--space-20);
  }

  .district-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-4);
    margin-bottom: var(--space-10);
    border-bottom: 1px solid var(--colour-border-subtle);
  }

  .district-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(245, 158, 11, 0.10);
    border: 1px solid rgba(245, 158, 11, 0.28);
    color: #f59e0b;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #f59e0b;
    box-shadow: 0 0 8px #f59e0b;
  }

  .district-controls {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .world-link-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--colour-fg-muted);
    text-decoration: none;
    padding: 3px 10px;
    background: var(--colour-surface-2);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-full);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .world-link-chip:hover {
    color: #f59e0b;
    border-color: rgba(245, 158, 11, 0.4);
  }

  .archive-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--colour-fg-subtle);
  }

  /* Featured Project Hero Block */
  .featured-exhibit-section {
    margin-bottom: var(--space-16);
  }

  .featured-card {
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-left: 4px solid #f59e0b;
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-sm);
  }

  .featured-badge-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .featured-kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: #f59e0b;
    letter-spacing: 0.08em;
  }

  .featured-status {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    color: var(--colour-fg-subtle);
  }

  .featured-content-grid {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .featured-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--leading-tight);
    margin-bottom: var(--space-2);
  }

  .featured-title-link {
    color: var(--colour-fg);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .featured-title-link:hover {
    color: #f59e0b;
  }

  .featured-subtitle {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: #f59e0b;
    margin-bottom: var(--space-4);
  }

  .featured-desc {
    font-size: var(--text-base);
    color: var(--colour-fg-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .featured-tags-cluster {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: var(--space-6);
  }

  .featured-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 3px 9px;
    background: var(--colour-surface-2);
    border: 1px solid var(--colour-border-subtle);
    border-radius: var(--radius-sm);
    color: var(--colour-fg-muted);
  }

  .featured-action-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .btn-featured-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: #f59e0b;
    color: #0b0f19;
    font-weight: 600;
    font-size: var(--text-xs);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .btn-featured-primary:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(245, 158, 11, 0.3);
  }

  .btn-featured-secondary {
    display: inline-flex;
    align-items: center;
    padding: 10px 16px;
    background: transparent;
    border: 1px solid var(--colour-border);
    color: var(--colour-fg);
    font-size: var(--text-xs);
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .btn-featured-secondary:hover {
    border-color: #f59e0b;
    color: #f59e0b;
  }

  .featured-specs-panel {
    background: var(--colour-surface-2);
    border: 1px solid var(--colour-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }

  .specs-title {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: #f59e0b;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }

  .specs-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
  }

  .spec-row dt {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--colour-fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .spec-row dd {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--colour-fg);
    margin: 0;
  }

  /* Discovery: Search & Filter Toolbar */
  .project-discovery-section {
    margin-top: var(--space-12);
  }

  .discovery-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-6);
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .discovery-heading {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--colour-fg);
  }

  .discovery-sub {
    font-size: var(--text-xs);
    color: var(--colour-fg-subtle);
    margin-top: 2px;
  }

  .search-wrap {
    position: relative;
    min-width: 260px;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--colour-fg-subtle);
    pointer-events: none;
  }

  .lab-search-input {
    width: 100%;
    padding: 8px 12px 8px 34px;
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-full);
    color: var(--colour-fg);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    outline: none;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .lab-search-input:focus {
    border-color: #f59e0b;
    box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.2);
  }

  .category-filter-strip {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-8);
  }

  .filter-pill {
    padding: 6px 14px;
    background: var(--colour-surface-2);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-full);
    color: var(--colour-fg-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
    outline: none;
  }

  .filter-pill:hover {
    color: var(--colour-fg);
    border-color: #f59e0b;
  }

  .filter-pill.is-active {
    background: #f59e0b;
    color: #0b0f19;
    font-weight: 700;
    border-color: #f59e0b;
  }

  .reset-filter-btn {
    padding: 6px 12px;
    background: transparent;
    border: 1px dashed var(--colour-border);
    border-radius: var(--radius-full);
    color: var(--colour-fg-subtle);
    font-family: var(--font-mono);
    font-size: 10px;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .reset-filter-btn:hover {
    color: var(--colour-fg);
    border-color: var(--colour-fg-subtle);
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--space-6);
  }

  /* Empty State */
  .projects-empty-state {
    text-align: center;
    padding: var(--space-12) var(--space-6);
    background: var(--colour-surface);
    border: 1px dashed var(--colour-border);
    border-radius: var(--radius-lg);
  }

  .empty-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--colour-surface-2);
    color: var(--colour-fg-subtle);
    margin-bottom: var(--space-3);
  }

  .empty-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--colour-fg);
    margin-bottom: var(--space-2);
  }

  .empty-desc {
    font-size: var(--text-xs);
    color: var(--colour-fg-muted);
    max-width: 45ch;
    margin-inline: auto;
    margin-bottom: var(--space-5);
  }

  .btn-clear-search {
    padding: 8px 16px;
    background: #f59e0b;
    color: #0b0f19;
    font-weight: 600;
    font-size: var(--text-xs);
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: filter var(--duration-fast) var(--ease-out);
  }

  .btn-clear-search:hover {
    filter: brightness(1.1);
  }

  @media (max-width: 860px) {
    .featured-content-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
    .search-wrap {
      width: 100%;
    }
  }
</style>

<script>
  function setupWorkFilterAndSearch() {
    const searchInput = document.getElementById('lab-project-search') as HTMLInputElement | null;
    const filterPills = document.querySelectorAll('.filter-pill');
    const resetBtn = document.getElementById('reset-filter-btn');
    const clearSearchBtn = document.getElementById('btn-clear-search');
    const emptyState = document.getElementById('projects-empty-state');
    const projectCards = document.querySelectorAll<HTMLElement>('[data-project-card]');

    let activeFilter = 'all';
    let searchQuery = '';

    function filterMatchesCategory(card: HTMLElement, filter: string): boolean {
      if (filter === 'all') return true;

      const discipline = card.dataset.discipline || '';
      const tags = card.dataset.tags || '';

      if (filter === 'robotics') {
        return tags.includes('robotics') || tags.includes('kinematics') || discipline.includes('biomechatronics');
      }
      if (filter === 'mechanical') {
        return tags.includes('hardware') || tags.includes('ergonomics') || discipline.includes('hardware');
      }
      if (filter === 'embedded') {
        return tags.includes('embedded') || tags.includes('iot') || tags.includes('telemetry') || discipline.includes('iot');
      }
      if (filter === 'medical') {
        return tags.includes('medical') || tags.includes('prosthetics') || tags.includes('assistive') || tags.includes('ergonomics');
      }

      return true;
    }

    function applyFilters() {
      let visibleCount = 0;

      projectCards.forEach((card) => {
        const title = card.dataset.title || '';
        const description = card.dataset.description || '';
        const tags = card.dataset.tags || '';

        const textMatches = !searchQuery ||
          title.includes(searchQuery) ||
          description.includes(searchQuery) ||
          tags.includes(searchQuery);

        const categoryMatches = filterMatchesCategory(card, activeFilter);

        const isVisible = textMatches && categoryMatches;
        card.style.display = isVisible ? '' : 'none';
        if (isVisible) visibleCount++;
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      if (resetBtn) {
        resetBtn.style.display = (activeFilter !== 'all' || searchQuery !== '') ? 'inline-block' : 'none';
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
        applyFilters();
      });
    }

    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        filterPills.forEach(p => {
          p.classList.remove('is-active');
          p.setAttribute('aria-selected', 'false');
        });
        pill.classList.add('is-active');
        pill.setAttribute('aria-selected', 'true');
        activeFilter = pill.getAttribute('data-filter') || 'all';
        applyFilters();
      });
    });

    function resetAll() {
      activeFilter = 'all';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      filterPills.forEach((p, idx) => {
        p.classList.toggle('is-active', idx === 0);
        p.setAttribute('aria-selected', idx === 0 ? 'true' : 'false');
      });
      applyFilters();
    }

    if (resetBtn) resetBtn.addEventListener('click', resetAll);
    if (clearSearchBtn) clearSearchBtn.addEventListener('click', resetAll);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupWorkFilterAndSearch);
  } else {
    setupWorkFilterAndSearch();
  }
</script>
