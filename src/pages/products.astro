---
/**
 * Products page — KLA Interactives product family.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { klaProjects } from '../data/content';
---

<BaseLayout
  title="KLA Interactives — Products"
  description="DraftGrid, AraLoom, TabZones and JobPal — a growing family of digital tools by Devashish Tambade."
>
  <section class="hero" style="padding-block-end: var(--space-12);" aria-labelledby="products-heading">
    <div class="container">
      <div class="hero-inner">
        <p class="hero-label">
          <span class="kla-badge">KLA Interactives</span>
        </p>
        <h1 class="hero-heading" id="products-heading" style="font-size: var(--text-3xl);">
          Digital products built to think.
        </h1>
        <p class="hero-body">
          A growing family of tools designed around how people actually think, write and work.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-label="All products">
    <div class="container">
      <div class="card-grid card-grid--2" role="list">
        {klaProjects.map((project, i) => (
          <div role="listitem">
            <ProjectCard project={project} index={i} />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
