---
/**
 * About page — placeholder for first iteration.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="About Devashish Tambade — robotics engineer, research technologist and product builder."
>
  <section class="hero" aria-labelledby="about-heading">
    <div class="container">
      <div class="hero-inner">
        <p class="hero-label">About</p>
        <h1 class="hero-heading" id="about-heading">
          Hello. I'm <em>Devashish.</em>
        </h1>
        <p class="hero-body">
          This page is coming soon. In the meantime, you can explore my
          work and writing on the homepage.
        </p>
        <div class="hero-actions">
          <a href="/" class="btn btn-primary">Back to homepage</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
