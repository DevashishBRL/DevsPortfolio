---
/**
 * Homepage — Devashish Tambade
 * 
 * Cinematic Introduction Experience:
 * - Dedicated full-screen viewport (no navbar, no footer, no scrollbars).
 * - Left side: restrained editorial introduction and exactly two primary CTAs:
 *   1. "Explore My World"
 *   2. "Get in Touch"
 * - Right side: prominent robot companion taking centre stage with expressive face and dialogue.
 * - Prepares the 3D terrarium world in a dormant container ready for Step 2's transition.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import MiniatureWorld3D from '../components/MiniatureWorld3D.astro';
import RobotCompanion from '../components/RobotCompanion.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Devashish Tambade"
  description="Robotics engineer, research technologist and product builder working across robotics, software and human-centred design."
  hideHeader={true}
  hideFooter={true}
>
  <!-- ── Dedicated Full-Screen Introduction Stage ──────────────────────── -->
  <section class="intro-screen" id="intro-screen" aria-label="Introduction">
    <!-- Subtle architectural background ambiance -->
    <div class="intro-bg-grid" aria-hidden="true"></div>
    <div class="intro-bg-glow" aria-hidden="true"></div>

    <div class="intro-shell">
      <!-- ── Left Column: Editorial Introduction & Two Actions ── -->
      <div class="intro-narrative">
        <div class="intro-meta-badge">
          <span class="meta-dot" aria-hidden="true"></span>
          <span>DEVASHISH TAMBADE // PORTFOLIO</span>
        </div>

        <h1 class="intro-headline">
          I build things that make<br />
          <em class="serif">problems smaller.</em>
        </h1>

        <p class="intro-statement">
          Robotics engineer, research technologist, and builder. Working at the intersection of mechanical hardware, wearable medical enclosures, and digital thought software.
        </p>

        <p class="intro-substatement">
          Welcome to my digital campus. Take a moment to say hello to my companion bot, or step inside to explore the habitat.
        </p>

        <!-- Exactly Two Primary Actions -->
        <div class="intro-actions">
          <button type="button" class="btn btn-intro-primary" id="btn-explore-world">
            <span>Explore My World</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
            </svg>
          </button>

          <a href={`${base}about/`} class="btn btn-intro-secondary" id="btn-get-in-touch">
            <span>Get in Touch</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <div class="intro-footer-note">
          <span class="coord-label">HABITAT // BRISTOL, UK</span>
          <span class="coord-sep" aria-hidden="true">·</span>
          <span class="coord-val">LAT 51.45° N · LON 2.59° W</span>
        </div>
      </div>

      <!-- ── Right Column: The Companion Takes Centre Stage ── -->
      <div class="intro-companion-stage">
        <div class="companion-pedestal" aria-hidden="true">
          <div class="pedestal-ring pedestal-ring--outer"></div>
          <div class="pedestal-ring pedestal-ring--inner"></div>
        </div>

        <RobotCompanion
          mode="hero"
          initialMessage="Hello! I'm Devashish's companion bot. Ready to explore the habitat whenever you are."
        />
      </div>
    </div>
  </section>

  <!-- ── Dormant In-World Container (Preserved & Prepared for Step 2) ── -->
  <div id="world-experience-container" class="world-dormant" aria-hidden="true">
    <MiniatureWorld3D />
  </div>
</BaseLayout>

<script>
  // Step 1: Hook the 'Explore My World' button interaction
  const exploreBtn = document.getElementById('btn-explore-world');
  exploreBtn?.addEventListener('click', () => {
    // Notify the companion to react
    window.dispatchEvent(new CustomEvent('companion-trigger-takeoff'));
    // Step 2 will wire the complete seamless transition into full-screen world
  });
</script>

<style is:global>
  /* Lock page strictly to the visible viewport on homepage */
  html, body {
    overflow: hidden !important;
    height: 100% !important;
    max-height: 100vh !important;
    max-height: 100dvh !important;
    margin: 0;
    padding: 0;
  }
</style>

<style>
  /* ── Dedicated Full-Screen Introduction Stage ──────────────────────── */

  .intro-screen {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--colour-bg);
    overflow: hidden;
    z-index: 50;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    box-sizing: border-box;
  }

  .intro-bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--colour-border-subtle) 1px, transparent 1px),
      linear-gradient(90deg, var(--colour-border-subtle) 1px, transparent 1px);
    background-size: 56px 56px;
    opacity: 0.35;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 100%);
  }

  .intro-bg-glow {
    position: absolute;
    top: 25%;
    right: 15%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.08) 0%, transparent 70%);
    pointer-events: none;
    filter: blur(50px);
  }

  .intro-shell {
    width: 100%;
    max-width: 1140px;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  /* ── Left Column: Narrative & Actions ── */
  .intro-narrative {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .intro-meta-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    color: var(--colour-accent);
    background: var(--colour-accent-bg);
    padding: 4px 12px;
    border-radius: 9999px;
    border: 1px solid rgba(245, 158, 11, 0.25);
    margin-bottom: var(--space-6);
  }

  .meta-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--colour-accent);
    box-shadow: 0 0 8px var(--colour-accent);
  }

  .intro-headline {
    font-size: clamp(2.4rem, 2rem + 2.5vw, 4.2rem);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--colour-fg);
    margin-bottom: var(--space-6);
  }

  .intro-headline em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--colour-accent);
  }

  .intro-statement {
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--colour-fg);
    font-weight: 500;
    max-width: 52ch;
    margin-bottom: var(--space-3);
  }

  .intro-substatement {
    font-size: var(--text-sm);
    line-height: var(--leading-loose);
    color: var(--colour-fg-muted);
    max-width: 48ch;
    margin-bottom: var(--space-8);
  }

  /* Exactly Two Buttons */
  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .btn-intro-primary {
    background: var(--colour-accent);
    color: #ffffff;
    border: 1.5px solid var(--colour-accent);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    padding: var(--space-3) var(--space-8);
    border-radius: var(--radius-md);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    box-shadow: 0 6px 20px rgba(245, 158, 11, 0.3);
    transition: all var(--duration-fast) var(--ease-out);
    min-height: 48px;
  }

  .btn-intro-primary:hover {
    background: var(--colour-accent-dim);
    border-color: var(--colour-accent-dim);
    transform: translateY(-2px);
    box-shadow: 0 8px 26px rgba(245, 158, 11, 0.42);
  }

  .btn-intro-primary:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--colour-bg), 0 0 0 4px var(--colour-accent);
  }

  .btn-intro-secondary {
    background: transparent;
    color: var(--colour-fg);
    border: 1.5px solid var(--colour-border);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    padding: var(--space-3) var(--space-7);
    border-radius: var(--radius-md);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    transition: all var(--duration-fast) var(--ease-out);
    min-height: 48px;
  }

  .btn-intro-secondary:hover {
    background: var(--colour-bg-raised);
    border-color: var(--colour-fg-muted);
    transform: translateY(-1px);
  }

  .btn-intro-secondary:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .intro-footer-note {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--colour-fg-subtle);
    padding-top: var(--space-4);
    border-top: 1px solid var(--colour-border-subtle);
    width: 100%;
    max-width: 440px;
  }

  .coord-label {
    font-weight: 600;
  }

  .coord-sep {
    color: var(--colour-border);
  }

  /* ── Right Column: Companion Hero Stage ── */
  .intro-companion-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 380px;
  }

  .companion-pedestal {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 240px;
    height: 60px;
    pointer-events: none;
  }

  .pedestal-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px dashed var(--colour-border);
    opacity: 0.5;
  }

  .pedestal-ring--inner {
    inset: 12px 30px;
    border-style: solid;
    border-color: rgba(245, 158, 11, 0.25);
    opacity: 0.7;
  }

  /* ── Dormant in-DOM 3D World (Prepared for Step 2) ── */
  .world-dormant {
    display: none;
  }

  /* ── Responsive Adaptations ── */
  @media (max-width: 960px) {
    .intro-shell {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      text-align: center;
    }

    .intro-narrative {
      align-items: center;
      order: 2;
    }

    .intro-companion-stage {
      order: 1;
      min-height: 240px;
    }

    .intro-actions {
      justify-content: center;
    }

    .intro-footer-note {
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .intro-screen {
      padding: var(--space-4);
      align-items: center;
    }

    .intro-headline {
      font-size: 1.85rem;
      margin-bottom: var(--space-4);
    }

    .intro-statement {
      font-size: var(--text-sm);
    }

    .intro-substatement {
      display: none; /* Keep clean on small mobile screens */
    }

    .intro-actions {
      flex-direction: column;
      width: 100%;
      gap: var(--space-3);
    }

    .btn-intro-primary,
    .btn-intro-secondary {
      width: 100%;
      justify-content: center;
    }

    .intro-companion-stage {
      min-height: 180px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-intro-primary,
    .btn-intro-secondary {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
