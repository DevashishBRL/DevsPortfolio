---
/**
 * Homepage — Devashish Tambade
 * 
 * Cinematic Introduction & Full-Screen World Experience:
 * - Three explicit states: 'intro' | 'entering-world' | 'world'.
 * - 'intro': Minimal full-screen greeting with companion hero and 2 primary CTAs.
 * - 'entering-world': Cheerful companion acknowledgment + flying-away takeoff animation, smooth world reveal.
 * - 'world': Full-viewport interactive Three.js terrarium with Back to Intro control.
 * - Seamless return to intro without page reload or WebGL remounting.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import MiniatureWorld3D from '../components/MiniatureWorld3D.astro';
import RobotCompanion from '../components/RobotCompanion.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Devashish Tambade"
  description="Robotics engineer, research technologist and product builder working across robotics, software and human-centred design."
  hideHeader={true}
  hideFooter={true}
>
  <div id="experience-viewport" class="experience-viewport" data-state="intro">
    <!-- ── 1. Dedicated Full-Screen Introduction Stage ──────────────────── -->
    <section class="intro-screen" id="intro-screen" aria-label="Introduction">
      <!-- Subtle architectural background ambiance -->
      <div class="intro-bg-grid" aria-hidden="true"></div>
      <div class="intro-bg-glow" aria-hidden="true"></div>

      <div class="intro-shell">
        <!-- ── Left Column: Editorial Introduction & Two Actions ── -->
        <div class="intro-narrative">
          <div class="intro-meta-badge">
            <span class="meta-dot" aria-hidden="true"></span>
            <span>DEVASHISH TAMBADE // PORTFOLIO</span>
          </div>

          <h1 class="intro-headline">
            I build things that make<br />
            <em class="serif">problems smaller.</em>
          </h1>

          <p class="intro-statement">
            Robotics engineer, research technologist, and builder. Working at the intersection of mechanical hardware, wearable medical enclosures, and digital thought software.
          </p>

          <p class="intro-substatement">
            Welcome to my digital campus. Take a moment to say hello to my companion bot, or step inside to explore the habitat.
          </p>

          <!-- Exactly Two Primary Actions -->
          <div class="intro-actions">
            <button
              type="button"
              class="btn btn-intro-primary"
              id="btn-explore-world"
              aria-label="Explore the interactive miniature world"
            >
              <span>Explore My World</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
              </svg>
            </button>

            <a
              href={`${base}about/`}
              class="btn btn-intro-secondary"
              id="btn-get-in-touch"
              aria-label="Get in touch with Devashish"
            >
              <span>Get in Touch</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>

          <div class="intro-footer-note">
            <span class="coord-label">HABITAT // BRISTOL, UK</span>
            <span class="coord-sep" aria-hidden="true">·</span>
            <span class="coord-val">LAT 51.45° N · LON 2.59° W</span>
          </div>
        </div>

        <!-- ── Right Column: The Companion Takes Centre Stage ── -->
        <div class="intro-companion-stage">
          <div class="companion-pedestal" aria-hidden="true">
            <div class="pedestal-ring pedestal-ring--outer"></div>
            <div class="pedestal-ring pedestal-ring--inner"></div>
          </div>

          <RobotCompanion
            mode="hero"
            initialMessage="Hello! I'm Devashish's companion bot. Ready to explore the habitat whenever you are."
          />
        </div>
      </div>
    </section>

    <!-- ── 2. Full-Screen 3D Terrarium World Experience ─────────────────── -->
    <div
      id="world-experience-container"
      class="world-fullscreen-container"
      aria-hidden="true"
      role="region"
      aria-label="Full-Screen Interactive 3D World"
    >
      <div class="world-fullscreen">
        <MiniatureWorld3D />
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function initExperienceController() {
    const root = document.getElementById('experience-viewport');
    const exploreBtn = document.getElementById('btn-explore-world');
    const introScreen = document.getElementById('intro-screen');
    const worldContainer = document.getElementById('world-experience-container');

    if (!root || !exploreBtn || !introScreen || !worldContainer) return;

    let currentState = 'intro'; // 'intro' | 'entering-world' | 'world'

    function setExperienceState(newState: 'intro' | 'entering-world' | 'world') {
      if (currentState === newState) return;
      currentState = newState;
      root.dataset.state = newState;

      if (newState === 'intro') {
        introScreen.setAttribute('aria-hidden', 'false');
        worldContainer.setAttribute('aria-hidden', 'true');
        exploreBtn.removeAttribute('disabled');
        exploreBtn.focus();
      } else if (newState === 'entering-world') {
        exploreBtn.setAttribute('disabled', 'true');
        // 1. Companion acknowledges and takes off
        window.dispatchEvent(new CustomEvent('companion-trigger-takeoff'));

        // 2. Check reduced-motion preference for timing
        const prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const transitionDuration = prefersReducedMotion ? 40 : 850;

        setTimeout(() => {
          setExperienceState('world');
        }, transitionDuration);
      } else if (newState === 'world') {
        introScreen.setAttribute('aria-hidden', 'true');
        worldContainer.setAttribute('aria-hidden', 'false');
        // 3. Notify Three.js scene to fit the full viewport and focus canvas
        window.dispatchEvent(new CustomEvent('enter-world-mode'));
        const canvas = worldContainer.querySelector<HTMLElement>('#mw3d-canvas-container');
        canvas?.focus();
      }
    }

    // Step 2: Handle "Explore My World" Activation
    exploreBtn.addEventListener('click', () => {
      if (currentState === 'intro') {
        setExperienceState('entering-world');
      }
    });

    // Step 2: Handle "Back to Intro" Activation from World HUD
    window.addEventListener('return-to-intro', () => {
      setExperienceState('intro');
    });

    // Keyboard accessibility: Escape key returns to intro if in world mode
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && currentState === 'world') {
        window.dispatchEvent(new CustomEvent('return-to-intro'));
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initExperienceController);
  } else {
    initExperienceController();
  }
</script>

<style is:global>
  /* Lock page strictly to the visible viewport on homepage */
  html, body {
    overflow: hidden !important;
    height: 100% !important;
    max-height: 100vh !important;
    max-height: 100dvh !important;
    margin: 0;
    padding: 0;
  }
</style>

<style>
  /* ── Master Experience Viewport Container ──────────────────────────── */

  .experience-viewport {
    position: relative;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  /* ── 1. Dedicated Full-Screen Introduction Stage ───────────────────── */

  .intro-screen {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--colour-bg);
    overflow: hidden;
    z-index: 50;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    box-sizing: border-box;
    transition: opacity 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0.6s ease;
    transform-origin: center center;
  }

  /* Transition state styling */
  [data-state="entering-world"] .intro-screen {
    opacity: 0;
    transform: scale(0.96) translateY(-10px);
    pointer-events: none;
  }

  [data-state="world"] .intro-screen {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .intro-bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--colour-border-subtle) 1px, transparent 1px),
      linear-gradient(90deg, var(--colour-border-subtle) 1px, transparent 1px);
    background-size: 56px 56px;
    opacity: 0.35;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, black 30%, transparent 100%);
  }

  .intro-bg-glow {
    position: absolute;
    top: 25%;
    right: 15%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.08) 0%, transparent 70%);
    pointer-events: none;
    filter: blur(50px);
  }

  .intro-shell {
    width: 100%;
    max-width: 1140px;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  /* Left Column: Narrative & Actions */
  .intro-narrative {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .intro-meta-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    color: var(--colour-accent);
    background: var(--colour-accent-bg);
    padding: 4px 12px;
    border-radius: 9999px;
    border: 1px solid rgba(245, 158, 11, 0.25);
    margin-bottom: var(--space-6);
  }

  .meta-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--colour-accent);
    box-shadow: 0 0 8px var(--colour-accent);
  }

  .intro-headline {
    font-size: clamp(2.4rem, 2rem + 2.5vw, 4.2rem);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--colour-fg);
    margin-bottom: var(--space-6);
  }

  .intro-headline em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    color: var(--colour-accent);
  }

  .intro-statement {
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--colour-fg);
    font-weight: 500;
    max-width: 52ch;
    margin-bottom: var(--space-3);
  }

  .intro-substatement {
    font-size: var(--text-sm);
    line-height: var(--leading-loose);
    color: var(--colour-fg-muted);
    max-width: 48ch;
    margin-bottom: var(--space-8);
  }

  /* Two Primary Buttons */
  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .btn-intro-primary {
    background: var(--colour-accent);
    color: #ffffff;
    border: 1.5px solid var(--colour-accent);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    padding: var(--space-3) var(--space-8);
    border-radius: var(--radius-md);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    box-shadow: 0 6px 20px rgba(245, 158, 11, 0.3);
    transition: all var(--duration-fast) var(--ease-out);
    min-height: 48px;
  }

  .btn-intro-primary:hover:not(:disabled) {
    background: var(--colour-accent-dim);
    border-color: var(--colour-accent-dim);
    transform: translateY(-2px);
    box-shadow: 0 8px 26px rgba(245, 158, 11, 0.42);
  }

  .btn-intro-primary:disabled {
    opacity: 0.65;
    cursor: wait;
    transform: none;
  }

  .btn-intro-primary:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--colour-bg), 0 0 0 4px var(--colour-accent);
  }

  .btn-intro-secondary {
    background: transparent;
    color: var(--colour-fg);
    border: 1.5px solid var(--colour-border);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    padding: var(--space-3) var(--space-7);
    border-radius: var(--radius-md);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    transition: all var(--duration-fast) var(--ease-out);
    min-height: 48px;
  }

  .btn-intro-secondary:hover {
    background: var(--colour-bg-raised);
    border-color: var(--colour-fg-muted);
    transform: translateY(-1px);
  }

  .btn-intro-secondary:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .intro-footer-note {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--colour-fg-subtle);
    padding-top: var(--space-4);
    border-top: 1px solid var(--colour-border-subtle);
    width: 100%;
    max-width: 440px;
  }

  .coord-label {
    font-weight: 600;
  }

  .coord-sep {
    color: var(--colour-border);
  }

  /* Right Column: Companion Hero Stage */
  .intro-companion-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 380px;
  }

  .companion-pedestal {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 240px;
    height: 60px;
    pointer-events: none;
  }

  .pedestal-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px dashed var(--colour-border);
    opacity: 0.5;
  }

  .pedestal-ring--inner {
    inset: 12px 30px;
    border-style: solid;
    border-color: rgba(245, 158, 11, 0.25);
    opacity: 0.7;
  }

  /* ── 2. Full-Screen 3D Terrarium World Container ─────────────────────── */

  .world-fullscreen-container {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    z-index: 100;
    overflow: hidden;
    background: #0c1018;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: scale(1.02);
    transition: opacity 0.75s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.75s cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0.75s ease;
  }

  [data-state="entering-world"] .world-fullscreen-container {
    visibility: visible;
    opacity: 0.85;
    transform: scale(1.008);
  }

  [data-state="world"] .world-fullscreen-container {
    visibility: visible;
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  /* Adapt MiniatureWorld3D for 100% full-viewport display */
  :global(.world-fullscreen) :global(.mw3d-wrapper) {
    height: 100vh;
    height: 100dvh;
    padding: 0;
    margin: 0;
    border: none;
    display: flex;
    flex-direction: column;
  }

  :global(.world-fullscreen) :global(.mw3d-container) {
    max-width: 100%;
    height: 100%;
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  :global(.world-fullscreen) :global(.mw3d-header) {
    display: none; /* Hide top section header in full-screen world mode */
  }

  :global(.world-fullscreen) :global(.mw3d-stage) {
    flex: 1;
    min-height: 0;
    padding: var(--space-2);
    gap: var(--space-3);
  }

  :global(.world-fullscreen) :global(.mw3d-canvas-wrap) {
    min-height: 0;
    height: 100%;
    border-radius: var(--radius-md);
  }

  :global(.world-fullscreen) :global(.mw3d-destinations-grid) {
    margin-top: var(--space-2);
    gap: var(--space-2);
  }

  :global(.world-fullscreen) :global(.mw3d-nav-card) {
    padding: var(--space-2) var(--space-3);
    min-height: auto;
  }

  :global(.world-fullscreen) :global(.nav-card-desc) {
    display: none; /* Keep bottom cards strip sleek in full-screen mode */
  }

  /* ── Responsive Adaptations ── */
  @media (max-width: 960px) {
    .intro-shell {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      text-align: center;
    }

    .intro-narrative {
      align-items: center;
      order: 2;
    }

    .intro-companion-stage {
      order: 1;
      min-height: 240px;
    }

    .intro-actions {
      justify-content: center;
    }

    .intro-footer-note {
      justify-content: center;
    }

    :global(.world-fullscreen) :global(.mw3d-stage) {
      grid-template-columns: 1fr;
    }

    :global(.world-fullscreen) :global(.mw3d-field-panel) {
      display: none; /* Step 4 will introduce responsive bottom sheet */
    }
  }

  @media (max-width: 640px) {
    .intro-screen {
      padding: var(--space-4);
      align-items: center;
    }

    .intro-headline {
      font-size: 1.85rem;
      margin-bottom: var(--space-4);
    }

    .intro-statement {
      font-size: var(--text-sm);
    }

    .intro-substatement {
      display: none;
    }

    .intro-actions {
      flex-direction: column;
      width: 100%;
      gap: var(--space-3);
    }

    .btn-intro-primary,
    .btn-intro-secondary {
      width: 100%;
      justify-content: center;
    }

    .intro-companion-stage {
      min-height: 180px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-screen,
    .world-fullscreen-container,
    .btn-intro-primary,
    .btn-intro-secondary {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
