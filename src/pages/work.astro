---
/**
 * Work page — all engineering & research projects.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { engineeringProjects } from '../data/content';
---

<BaseLayout
  title="Engineering & Research"
  description="Robotics, embedded systems, simulation and technical research projects by Devashish Tambade."
>
  <section class="hero" style="padding-block-end: var(--space-12);" aria-labelledby="work-heading">
    <div class="container">
      <div class="hero-inner">
        <p class="hero-label">Engineering & Research</p>
        <h1 class="hero-heading" id="work-heading" style="font-size: var(--text-3xl);">
          Projects & Research
        </h1>
        <p class="hero-body">
          Work that lives at the intersection of hardware, software and systems thinking.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-label="All engineering projects">
    <div class="container">
      <div class="card-grid" role="list">
        {engineeringProjects.map((project, i) => (
          <div role="listitem">
            <ProjectCard project={project} index={i} />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
