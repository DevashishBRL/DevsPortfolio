---
import PageLayout from '../../layouts/PageLayout.astro';
---
<PageLayout
  title="TabZones — KLA Interactives"
  description="TabZones is a focused browser workspace management tool — isolating tasks and minimising context switching. In active development."
  label="KLA Interactives — In Development"
  heading="TabZones"
  subheading="Purposeful browser workspaces"
>
  <article class="case-study">
    <div class="container case-study-grid">
      <div class="case-main">
        <section class="case-section">
          <h2 class="cs-heading">The Idea</h2>
          <p>Browser tabs multiply without discipline. Research, communication, work tools and distractions all coexist in the same space. TabZones creates named, intentional workspaces — so the browser reflects the task, not the accumulation of the day.</p>
        </section>
        <section class="case-section">
          <h2 class="cs-heading">Current Status</h2>
          <div class="case-note">
            <p>TabZones is in active development as a browser extension. Not yet published to any extension store. No release date has been confirmed.</p>
          </div>
        </section>
      </div>
      <aside class="case-meta">
        <div class="case-meta-card">
          <dl class="case-meta-list">
            <div class="case-meta-item"><dt>Studio</dt><dd>KLA Interactives</dd></div>
            <div class="case-meta-item"><dt>Type</dt><dd>Browser Extension</dd></div>
            <div class="case-meta-item"><dt>Status</dt><dd>In Development</dd></div>
          </dl>
          <div class="case-meta-tags">
            {['Browser Extension', 'Productivity', 'Focus'].map(t => (
              <span class="tag">{t}</span>
            ))}
          </div>
        </div>
        <a href={`${import.meta.env.BASE_URL}studio/`} class="back-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
          </svg>
          All products
        </a>
      </aside>
    </div>
  </article>
</PageLayout>

