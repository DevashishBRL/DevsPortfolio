---
/**
 * /studio/ — KLA Interactives & Experimental Systems
 * Color identity: ORANGE (#fb923c / var(--accent-studio))
 * Personality: Experimentation, imagination, prototyping, visual thinking and creative freedom.
 * Single Source of Truth: Pulls directly from Astro Content Collections ('products') managed via Pages CMS.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

// Live products from CMS collection
const allProducts = await getCollection('products');

// Sort: featured first, then alphabetical
const sortedProducts = allProducts.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return a.data.title.localeCompare(b.data.title);
});

const statusLabels: Record<string, string> = {
  concept: 'Concept Stage',
  active: 'In Active Development',
  beta: 'Beta Release',
  launched: 'Publicly Launched',
};
---

<PageLayout
  title="Studio — KLA Interactives & The Foundry"
  description="KLA Interactives: A software playground and product foundry crafting thoughtful tools around how people actually think and work."
  label="03 / THE FOUNDRY"
  heading="Ideas become things people can use."
  subheading="A creative technology studio exploring focused digital utilities, visual knowledge mapping, and intentional productivity."
>
  <div class="studio-experience">
    <!-- District Identity Banner -->
    <div class="district-badge-row">
      <div class="district-badge-pill">
        <span class="badge-dot" aria-hidden="true"></span>
        <span>DISTRICT 03 // THE FOUNDRY</span>
      </div>
      <a href={`${base}#miniature-world-3d`} class="district-world-link" title="View The Foundry in 3D Miniature Terrarium">
        <span>Locate in World</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
        </svg>
      </a>
    </div>

    <!-- Studio Manifest -->
    <section class="studio-manifesto" aria-labelledby="manifesto-heading">
      <div class="manifesto-card">
        <div class="manifesto-tag">STUDIO PHILOSOPHY</div>
        <h2 class="manifesto-lead" id="manifesto-heading">
          Building software around human cognitive reality, not corporate compliance.
        </h2>
        <p class="manifesto-body">
          Most modern digital tools demand that humans adapt to the database. At KLA Interactives, we prototype software designed around mental friction: reducing context switching, organizing sprawling research notes before writing, and removing dread from high-stakes workflows.
        </p>
      </div>
    </section>

    <!-- KLA Interactives Identity Block -->
    <section class="kla-identity-section" aria-labelledby="kla-heading">
      <div class="kla-card">
        <div class="kla-header">
          <div>
            <span class="kla-label">INDEPENDENT PRODUCT STUDIO</span>
            <h2 class="kla-title" id="kla-heading">KLA Interactives</h2>
          </div>
          <span class="kla-tagline">Software that maps to cognition</span>
        </div>
        <p class="kla-desc">
          KLA Interactives is an independent software workshop focused on creating digital thought tools. Rather than chasing growth hacks or bloated enterprise suites, every project originates from observing real workflow friction: blank-page paralysis, chaotic browser multitasking, and disconnected knowledge webs.
        </p>
        <div class="kla-pillars">
          <div class="pillar">
            <span class="pillar-bullet">◈</span>
            <div>
              <strong>Structure Before Prose:</strong> Tools that help you frame complex architectures before writing a single sentence.
            </div>
          </div>
          <div class="pillar">
            <span class="pillar-bullet">◈</span>
            <div>
              <strong>Calm Workspaces:</strong> Browser environments that isolate intent and protect sustained focus.
            </div>
          </div>
          <div class="pillar">
            <span class="pillar-bullet">◈</span>
            <div>
              <strong>Spatial Knowledge:</strong> Systems that treat ideas as connected terrains rather than isolated bullet lists.
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Products Showcase -->
    <section class="studio-products-section" aria-labelledby="products-heading">
      <div class="section-heading-bar">
        <div class="heading-icon-wrap">
          <span class="tool-dot" aria-hidden="true"></span>
          <h2 class="section-title" id="products-heading">Software Rigs & Active Tools</h2>
        </div>
        <span class="heading-count">{allProducts.length} Tools</span>
      </div>

      <div class="products-showcase-grid">
        {sortedProducts.map((product) => (
          <article class={`product-canvas-card ${product.data.featured ? 'is-flagship' : ''}`}>
            <div class="card-status-strip">
              <span class="product-status-tag">
                <span class="status-amber-dot" aria-hidden="true"></span>
                <span>{statusLabels[product.data.status] || product.data.status}</span>
              </span>
              <span class="platform-badge">{product.data.platform}</span>
            </div>

            <div class="card-content-block">
              <h3 class="product-name">
                <a href={`${base}studio/${product.slug}/`} class="product-link">
                  {product.data.title}
                </a>
              </h3>
              <p class="product-subtitle">{product.data.subtitle}</p>
              <p class="product-description">{product.data.description}</p>
            </div>

            {product.data.tags && product.data.tags.length > 0 && (
              <ul class="product-tags" aria-label="Product concepts">
                {product.data.tags.map(tag => (
                  <li class="studio-tag">{tag}</li>
                ))}
              </ul>
            )}

            {product.data.note && (
              <p class="product-note">
                <span class="note-bullet">ⓘ</span> {product.data.note}
              </p>
            )}

            <div class="card-action-bar">
              <a href={`${base}studio/${product.slug}/`} class="inspect-btn">
                <span>Inspect Tool Concept</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Studio Call to Action -->
    <section class="studio-cta-section" aria-labelledby="cta-heading">
      <div class="studio-cta-card">
        <span class="cta-kicker">FOUNDRY COLLABORATION</span>
        <h2 class="cta-title" id="cta-heading">Have an idea worth exploring? Or a workflow that software gets wrong?</h2>
        <p class="cta-body">
          We build tools to solve genuine cognitive friction. If you're tackling tricky information architecture problems or want to discuss early prototype feedback, reach out to the studio.
        </p>
        <div class="cta-actions">
          <a href="mailto:ka24911@bristol.ac.uk" class="cta-primary-btn">
            <span>Work with the Foundry</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .studio-experience {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block-end: var(--space-20);
  }

  .district-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-3);
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--colour-border-subtle);
  }

  .district-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(251, 146, 60, 0.08);
    border: 1px solid rgba(251, 146, 60, 0.25);
    color: var(--accent-studio, #fb923c);
    padding: 4px 12px;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-studio, #fb923c);
    box-shadow: 0 0 8px rgba(251, 146, 60, 0.8);
  }

  .district-world-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--colour-fg-muted);
    text-decoration: none;
    padding: 3px 10px;
    border-radius: 9999px;
    border: 1px solid var(--colour-border-subtle);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .district-world-link:hover {
    color: var(--accent-studio, #fb923c);
    border-color: rgba(251, 146, 60, 0.4);
    background: rgba(251, 146, 60, 0.06);
    transform: translateY(-1px);
  }

  .studio-manifesto {
    margin-bottom: var(--space-12);
  }

  .manifesto-card {
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-left: 4px solid var(--accent-studio, #fb923c);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-sm);
  }

  .manifesto-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--accent-studio, #fb923c);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
  }

  .manifesto-lead {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--colour-fg);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-4);
  }

  .manifesto-body {
    font-size: var(--text-base);
    color: var(--colour-fg-muted);
    line-height: var(--leading-relaxed);
    max-width: 70ch;
  }

  .kla-identity-section {
    margin-bottom: var(--space-16);
  }

  .kla-card {
    background: var(--colour-surface-elevated, var(--colour-surface));
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-sm);
  }

  .kla-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .kla-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--accent-studio, #fb923c);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 2px;
  }

  .kla-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--colour-fg);
  }

  .kla-tagline {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--colour-fg-subtle);
  }

  .kla-desc {
    font-size: var(--text-sm);
    color: var(--colour-fg-muted);
    line-height: var(--leading-relaxed);
    max-width: 72ch;
    margin-bottom: var(--space-6);
  }

  .kla-pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--colour-border-subtle);
  }

  .pillar {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: var(--text-xs);
    color: var(--colour-fg-muted);
    line-height: var(--leading-normal);
  }

  .pillar-bullet {
    color: var(--accent-studio, #fb923c);
    font-size: 11px;
    flex-shrink: 0;
  }

  .studio-products-section {
    margin-bottom: var(--space-16);
  }

  .section-heading-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--colour-border-subtle);
    margin-bottom: var(--space-8);
  }

  .heading-icon-wrap {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .tool-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-studio, #fb923c);
    box-shadow: 0 0 10px rgba(251, 146, 60, 0.7);
  }

  .section-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--colour-fg);
  }

  .heading-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--colour-fg-subtle);
  }

  .products-showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--space-6);
  }

  .product-canvas-card {
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all var(--duration-fast) var(--ease-out);
    position: relative;
    box-shadow: var(--shadow-sm);
  }

  .product-canvas-card:hover {
    border-color: rgba(251, 146, 60, 0.45);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .product-canvas-card.is-flagship {
    border-left: 3px solid var(--accent-studio, #fb923c);
  }

  .card-status-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .product-status-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent-studio, #fb923c);
    font-weight: 600;
  }

  .status-amber-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-studio, #fb923c);
    box-shadow: 0 0 6px var(--accent-studio, #fb923c);
  }

  .platform-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 2px 7px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--colour-border-subtle);
    color: var(--colour-fg-muted);
  }

  .product-name {
    font-size: var(--text-xl);
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  .product-link {
    color: var(--colour-fg);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .product-link:hover {
    color: var(--accent-studio, #fb923c);
  }

  .product-subtitle {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-studio, #fb923c);
    margin-bottom: var(--space-3);
  }

  .product-description {
    font-size: var(--text-sm);
    color: var(--colour-fg-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
  }

  .product-tags {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4) 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .studio-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--colour-surface-elevated, rgba(0, 0, 0, 0.04));
    border: 1px solid var(--colour-border-subtle);
    color: var(--colour-fg-muted);
  }

  .product-note {
    font-size: 11px;
    font-style: italic;
    color: var(--colour-fg-subtle);
    margin-bottom: var(--space-4);
    padding: 6px 10px;
    background: rgba(251, 146, 60, 0.04);
    border-left: 2px solid rgba(251, 146, 60, 0.4);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .note-bullet {
    color: var(--accent-studio, #fb923c);
    font-style: normal;
    margin-right: 2px;
  }

  .card-action-bar {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--colour-border-subtle);
  }

  .inspect-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent-studio, #fb923c);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    background: rgba(251, 146, 60, 0.08);
    border: 1px solid rgba(251, 146, 60, 0.22);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .inspect-btn:hover {
    background: rgba(251, 146, 60, 0.18);
    border-color: rgba(251, 146, 60, 0.45);
    transform: translateX(2px);
  }

  .studio-cta-section {
    margin-top: var(--space-8);
  }

  .studio-cta-card {
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-left: 4px solid var(--accent-studio, #fb923c);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-sm);
  }

  .cta-kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--accent-studio, #fb923c);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2);
    display: block;
  }

  .cta-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--colour-fg);
    margin-bottom: var(--space-3);
  }

  .cta-body {
    font-size: var(--text-sm);
    color: var(--colour-fg-muted);
    line-height: var(--leading-relaxed);
    max-width: 65ch;
    margin-bottom: var(--space-6);
  }

  .cta-actions {
    display: flex;
    gap: var(--space-4);
  }

  .cta-primary-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    color: #ffffff;
    background: var(--accent-studio, #fb923c);
    padding: 10px 18px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .cta-primary-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .products-showcase-grid {
      grid-template-columns: 1fr;
    }
    .kla-pillars {
      grid-template-columns: 1fr;
    }
  }
</style>
