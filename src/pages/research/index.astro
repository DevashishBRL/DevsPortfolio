---
/**
 * /research/ — Knowledge Laboratory & Systems Investigation
 * Color identity: CYAN / ELECTRIC BLUE (#38bdf8)
 * Personality: Curiosity, systems thinking, discovery, and intellectual exploration.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { researchAreas, workHistory } from '../../data/content';

const base = import.meta.env.BASE_URL;

// Live project collection for cross-referencing research work
const allProjects = await getCollection('projects');

const researchStatusLabels: Record<string, string> = {
  active: 'Active Investigation',
  exploring: 'Exploratory Vector',
  past: 'Completed Enquiry',
};
---

<PageLayout
  title="Research — Systems Investigation & Robotics"
  description="Knowledge laboratory, human-robot interaction vectors, biomechatronics research, and systems thinking by Devashish Tambade."
  label="02 / RESEARCH"
  heading="Curiosity & Systems Investigation"
  subheading="An evolving knowledge laboratory exploring the interface between mechatronics, accessible assistive devices, and human intent."
>
  <div class="research-lab">
    <!-- District Identity Banner -->
    <div class="district-badge-row">
      <div class="district-badge-pill">
        <span class="badge-dot" aria-hidden="true"></span>
        <span>THE OBSERVATORY // CYAN & ELECTRIC BLUE ACCENT</span>
      </div>
      <span class="district-meta">Laboratory Notebook & Active Hypotheses</span>
    </div>

    <!-- Editorial Abstract / Investigation Thesis -->
    <section class="research-hero-abstract" aria-labelledby="abstract-heading">
      <div class="abstract-card">
        <div class="abstract-meta-header">
          <span class="mono-label">RESEARCH THESIS & METHODOLOGY</span>
          <span class="mono-status">UNIVERSITY OF BRISTOL · ROBOTICS MENG</span>
        </div>
        <p class="abstract-lead">
          Engineering is fundamentally about understanding the invisible constraints of complex systems. My research focus bridges mechanical hardware, embedded sensory loops, and human-centred kinematics.
        </p>
        <p class="abstract-body">
          Rather than treating robotics purely as autonomous computing, my investigations focus on accessible prosthetic mechanisms and wearable enclosures: how physical systems negotiate contact, compliance, and cognitive affordance with real human users.
        </p>
        <div class="abstract-tags">
          <span class="theme-tag">Biomechatronics</span>
          <span class="theme-tag">Human–Robot Interaction</span>
          <span class="theme-tag">Embedded Telemetry</span>
          <span class="theme-tag">Physical Prototyping</span>
        </div>
      </div>
    </section>

    <!-- Research Areas & Vectors -->
    <section class="research-vectors-section" aria-labelledby="vectors-heading">
      <div class="section-heading-bar">
        <div class="heading-icon-wrap">
          <span class="vector-pulse" aria-hidden="true"></span>
          <h2 class="section-title" id="vectors-heading">Active Enquiry & Research Domains</h2>
        </div>
        <span class="heading-count">{researchAreas.length} Areas</span>
      </div>

      <div class="research-cards-grid">
        {researchAreas.map((area) => {
          // Find connected live CMS projects
          const relatedProjects = allProjects.filter(p =>
            area.relatedProjectIds?.includes(p.slug) ||
            p.data.tags.some(t => area.tags.includes(t))
          );

          return (
            <article class="research-card">
              <div class="research-card-header">
                <div class={`research-status-pill research-status-pill--${area.status}`}>
                  <span class="status-indicator-dot" aria-hidden="true"></span>
                  <span>{researchStatusLabels[area.status] || area.status}</span>
                </div>
              </div>

              <h3 class="research-card-title">{area.title}</h3>
              <p class="research-card-desc">{area.description}</p>

              {area.tags && area.tags.length > 0 && (
                <ul class="research-tags-list" aria-label="Investigation topics">
                  {area.tags.map(t => (
                    <li class="research-tag">{t}</li>
                  ))}
                </ul>
              )}

              {relatedProjects.length > 0 && (
                <div class="connected-projects-box">
                  <span class="connected-label">Connected Technical Work:</span>
                  <ul class="connected-list">
                    {relatedProjects.map(proj => (
                      <li>
                        <a href={`${base}work/${proj.slug}/`} class="connected-link">
                          <span>{proj.data.title}</span>
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                          </svg>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </article>
          );
        })}
      </div>
    </section>

    <!-- Epistemology & Scientific Principles -->
    <section class="research-principles-section" aria-labelledby="principles-heading">
      <div class="section-heading-bar">
        <div class="heading-icon-wrap">
          <span class="principles-icon" aria-hidden="true">◈</span>
          <h2 class="section-title" id="principles-heading">Core Investigation Principles</h2>
        </div>
      </div>

      <div class="principles-grid">
        <div class="principle-card">
          <span class="principle-num">01</span>
          <h3 class="principle-title">Prototypes as Research Instruments</h3>
          <p class="principle-desc">
            Physical rigs and 3D-printed assemblies are not mere demonstration models; they are apparatuses for discovering physical truth and unanticipated material constraints early.
          </p>
        </div>

        <div class="principle-card">
          <span class="principle-num">02</span>
          <h3 class="principle-title">Human-Context Grounding</h3>
          <p class="principle-desc">
            Kinematic models succeed or fail in the contact layer with human physiology. Research requirements originate from observing real human environments rather than sterile simulations.
          </p>
        </div>

        <div class="principle-card">
          <span class="principle-num">03</span>
          <h3 class="principle-title">Transparent Negative Results</h3>
          <p class="principle-desc">
            Documenting why a particular mechanism or sensor configuration failed provides as much technical value as successful trials. Intellectual integrity is non-negotiable.
          </p>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .research-lab {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block-end: var(--space-20);
  }

  .district-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-4);
    margin-bottom: var(--space-10);
    border-bottom: 1px solid var(--colour-border-subtle);
  }

  .district-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(56, 189, 248, 0.10);
    border: 1px solid rgba(56, 189, 248, 0.28);
    color: #38bdf8;
    padding: 4px 12px;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 8px #38bdf8;
  }

  .district-meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--colour-fg-subtle);
  }

  .research-hero-abstract {
    margin-bottom: var(--space-16);
  }

  .abstract-card {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.05) 0%, rgba(15, 23, 42, 0.6) 100%);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-left: 4px solid #38bdf8;
    border-radius: var(--radius-lg);
    padding: var(--space-8);
  }

  .abstract-meta-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .mono-label {
    color: #38bdf8;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .mono-status {
    color: var(--colour-fg-subtle);
  }

  .abstract-lead {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--colour-fg);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-4);
  }

  .abstract-body {
    font-size: var(--text-base);
    color: var(--colour-fg-muted);
    line-height: var(--leading-relaxed);
    max-width: 72ch;
    margin-bottom: var(--space-6);
  }

  .abstract-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .theme-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 3px 10px;
    border-radius: 9999px;
  }

  .research-vectors-section {
    margin-bottom: var(--space-16);
  }

  .section-heading-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--colour-border);
    margin-bottom: var(--space-8);
  }

  .heading-icon-wrap {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .vector-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 10px #38bdf8;
  }

  .principles-icon {
    color: #38bdf8;
    font-size: 14px;
  }

  .section-title {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    color: var(--colour-fg);
  }

  .heading-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--colour-fg-subtle);
  }

  .research-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: var(--space-6);
  }

  .research-card {
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all var(--duration-fast) var(--ease-out);
    position: relative;
  }

  .research-card:hover {
    border-color: rgba(56, 189, 248, 0.45);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .research-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .research-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .research-status-pill--active {
    color: #38bdf8;
  }

  .status-indicator-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 6px currentColor;
  }

  .research-card-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--colour-fg);
    margin-bottom: var(--space-3);
  }

  .research-card-desc {
    font-size: var(--text-sm);
    color: var(--colour-fg-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
  }

  .research-tags-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-5) 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .research-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--colour-border-subtle);
    color: var(--colour-fg-muted);
  }

  .connected-projects-box {
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--colour-border-subtle);
  }

  .connected-label {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--colour-fg-subtle);
    display: block;
    margin-bottom: var(--space-2);
  }

  .connected-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .connected-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-xs);
    font-weight: 500;
    color: #38bdf8;
    text-decoration: none;
    padding: 4px 8px;
    background: rgba(56, 189, 248, 0.06);
    border: 1px solid rgba(56, 189, 248, 0.18);
    border-radius: 4px;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .connected-link:hover {
    background: rgba(56, 189, 248, 0.14);
    border-color: #38bdf8;
    transform: translateX(2px);
  }

  .research-principles-section {
    margin-top: var(--space-12);
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .principle-card {
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    position: relative;
  }

  .principle-num {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 800;
    color: rgba(56, 189, 248, 0.25);
    margin-bottom: var(--space-2);
    display: block;
  }

  .principle-title {
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--colour-fg);
    margin-bottom: var(--space-2);
  }

  .principle-desc {
    font-size: var(--text-xs);
    color: var(--colour-fg-muted);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 640px) {
    .research-cards-grid,
    .principles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
