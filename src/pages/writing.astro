---
/**
 * Writing page — AnyBody Can Design articles.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { authoredArticles } from '../data/content';
---

<BaseLayout
  title="AnyBody Can Design — Writing"
  description="Personal writing about design, usability, observation and human interaction by Devashish Tambade."
>
  <section class="hero" style="padding-block-end: var(--space-12);" aria-labelledby="writing-heading">
    <div class="container">
      <div class="hero-inner">
        <p class="hero-label">Writing</p>
        <h1 class="hero-heading" id="writing-heading" style="font-size: var(--text-3xl);">
          AnyBody Can Design
        </h1>
        <p class="hero-body">
          Personal writing about design, usability, observation and human interaction.
          For anyone who thinks about how things work.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-label="All articles">
    <div class="container">
      <div class="article-list" role="list">
        {authoredArticles.map((article) => (
          <div role="listitem">
            <ArticleCard article={article} />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
