---
/**
 * /people/ — Community, Mentorship, Leadership and Shared Growth
 * Color identity: PURPLE (#a78bfa / var(--accent-people))
 * Personality: Community, collaboration, leadership, mentorship, teaching, and shared growth.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import { communityActivities } from '../../data/content';

const base = import.meta.env.BASE_URL;
---

<PageLayout
  title="People — Mentorship, Leadership & Community"
  description="Collaborative leadership, engineering peer mentorship, design thinking facilitation, and student communities by Devashish Tambade."
  label="05 / THE COMMONS"
  heading="Better things happen together."
  subheading="Engineering is about building functional physical systems. But it is equally about investing in the people, teams, and collaborative communities around you."
>
  <div class="people-experience">
    <!-- District Identity Banner -->
    <div class="district-badge-row">
      <div class="district-badge-pill">
        <span class="badge-dot" aria-hidden="true"></span>
        <span>DISTRICT 05 // THE COMMONS</span>
      </div>
      <a href={`${base}#miniature-world-3d`} class="district-world-link" title="View The Commons in 3D Miniature Terrarium">
        <span>Locate in World</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
        </svg>
      </a>
    </div>

    <!-- People Manifesto / Collaborative Ethos -->
    <section class="people-narrative-section" aria-labelledby="people-narrative-heading">
      <div class="narrative-card">
        <span class="narrative-kicker">COMMUNITY PHILOSOPHY</span>
        <h2 class="narrative-lead" id="people-narrative-heading">
          Technical excellence without mentorship is incomplete.
        </h2>
        <p class="narrative-body">
          The best engineering communities share knowledge freely, ask difficult questions without fear, and build capabilities in one another. Throughout my time in engineering and product development, some of the most rewarding work hasn't been in CAD software or code compilers, but in working side-by-side with fellow students, de-mystifying complex engineering concepts, and helping peers build confidence in their own technical problem-solving.
        </p>
      </div>
    </section>

    <!-- Community & Mentorship Initiatives Grid -->
    <section class="initiatives-section" aria-labelledby="initiatives-heading">
      <div class="section-heading-bar">
        <div class="heading-icon-wrap">
          <span class="people-spark" aria-hidden="true"></span>
          <h2 class="section-title" id="initiatives-heading">Mentorship, Teaching & Community Initiatives</h2>
        </div>
        <span class="heading-count">{communityActivities.length} Roles</span>
      </div>

      <div class="initiatives-grid">
        {communityActivities.map((activity) => (
          <article class="initiative-card">
            <div class="initiative-header">
              <span class="role-badge">{activity.role}</span>
              <span class="period-badge">{activity.period}</span>
            </div>

            <h3 class="initiative-title">{activity.title}</h3>
            {activity.organisation && (
              <p class="initiative-org">{activity.organisation}</p>
            )}

            <p class="initiative-desc">{activity.description}</p>

            {activity.tags && activity.tags.length > 0 && (
              <ul class="initiative-tags" aria-label="Leadership domains">
                {activity.tags.map(tag => (
                  <li class="community-tag">{tag}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>
    </section>

    <!-- Contributions Timeline Section -->
    <section class="contributions-timeline-section" aria-labelledby="timeline-heading">
      <div class="section-heading-bar">
        <div class="heading-icon-wrap">
          <span class="timeline-dot" aria-hidden="true"></span>
          <h2 class="section-title" id="timeline-heading">A Record of Contributions</h2>
        </div>
      </div>

      <div class="timeline-sequence">
        {communityActivities.map((activity) => (
          <div class="timeline-item">
            <div class="timeline-time-col">
              <span class="timeline-period-pill">{activity.period}</span>
              <span class="timeline-org-name">{activity.organisation}</span>
            </div>
            <div class="timeline-dot-connector" aria-hidden="true">
              <span class="dot-node"></span>
            </div>
            <div class="timeline-detail-col">
              <div class="timeline-role-row">
                <span class="timeline-role-tag">{activity.role}</span>
                <h3 class="timeline-title">{activity.title}</h3>
              </div>
              <p class="timeline-description">{activity.description}</p>
              {activity.tags && activity.tags.length > 0 && (
                <div class="timeline-tags">
                  {activity.tags.map(t => (
                    <span class="mini-tag">{t}</span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Leadership Perspectives -->
    <section class="mentorship-values-section" aria-labelledby="values-heading">
      <div class="section-heading-bar">
        <div class="heading-icon-wrap">
          <span class="values-glyph" aria-hidden="true">✦</span>
          <h2 class="section-title" id="values-heading">Mentorship Principles in Practice</h2>
        </div>
      </div>

      <div class="values-grid">
        <div class="value-card">
          <h3 class="value-title">Psychological Safety in Technical Inquiry</h3>
          <p class="value-desc">
            No one learns effectively when intimidated by technical jargon. Great engineering mentorship starts with creating spaces where any question can be asked without fear of judgment.
          </p>
        </div>

        <div class="value-card">
          <h3 class="value-title">Demystifying Problem-Framing</h3>
          <p class="value-desc">
            Students often freeze when faced with vague problem statements. Facilitating design thinking is about breaking intimidating challenges into tractable, testable sub-experiments.
          </p>
        </div>

        <div class="value-card">
          <h3 class="value-title">Building Communities of Practice</h3>
          <p class="value-desc">
            Sustainable learning happens peer-to-peer. Whether in faculty study groups or small software teams, lasting progress occurs when individuals teach and elevate one another.
          </p>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .people-experience {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block-end: var(--space-20);
  }

  .district-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-3);
    margin-bottom: var(--space-8);
    border-bottom: 1px solid var(--colour-border-subtle);
  }

  .district-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(167, 139, 250, 0.08);
    border: 1px solid rgba(167, 139, 250, 0.25);
    color: var(--accent-people, #a78bfa);
    padding: 4px 12px;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-people, #a78bfa);
    box-shadow: 0 0 8px rgba(167, 139, 250, 0.8);
  }

  .district-world-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--colour-fg-muted);
    text-decoration: none;
    padding: 3px 10px;
    border-radius: 9999px;
    border: 1px solid var(--colour-border-subtle);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .district-world-link:hover {
    color: var(--accent-people, #a78bfa);
    border-color: rgba(167, 139, 250, 0.4);
    background: rgba(167, 139, 250, 0.06);
    transform: translateY(-1px);
  }

  .people-narrative-section {
    margin-bottom: var(--space-12);
  }

  .narrative-card {
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-left: 4px solid var(--accent-people, #a78bfa);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-sm);
  }

  .narrative-kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--accent-people, #a78bfa);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-2);
    display: block;
  }

  .narrative-lead {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--colour-fg);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-4);
  }

  .narrative-body {
    font-size: var(--text-base);
    color: var(--colour-fg-muted);
    line-height: var(--leading-relaxed);
    max-width: 72ch;
  }

  .initiatives-section {
    margin-bottom: var(--space-16);
  }

  .section-heading-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--colour-border-subtle);
    margin-bottom: var(--space-8);
  }

  .heading-icon-wrap {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .people-spark {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-people, #a78bfa);
    box-shadow: 0 0 10px rgba(167, 139, 250, 0.7);
  }

  .timeline-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-people, #a78bfa);
  }

  .values-glyph {
    color: var(--accent-people, #a78bfa);
    font-size: 14px;
  }

  .section-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--colour-fg);
  }

  .heading-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--colour-fg-subtle);
  }

  .initiatives-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--space-6);
  }

  .initiative-card {
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all var(--duration-fast) var(--ease-out);
    box-shadow: var(--shadow-sm);
  }

  .initiative-card:hover {
    border-color: rgba(167, 139, 250, 0.45);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .initiative-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .role-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--accent-people, #a78bfa);
    background: rgba(167, 139, 250, 0.10);
    border: 1px solid rgba(167, 139, 250, 0.22);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .period-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--colour-fg-subtle);
  }

  .initiative-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--colour-fg);
    margin-bottom: var(--space-1);
  }

  .initiative-org {
    font-size: var(--text-xs);
    color: var(--accent-people, #a78bfa);
    font-family: var(--font-mono);
    margin-bottom: var(--space-3);
  }

  .initiative-desc {
    font-size: var(--text-sm);
    color: var(--colour-fg-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
  }

  .initiative-tags {
    list-style: none;
    padding: 0;
    margin: auto 0 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding-top: var(--space-4);
    border-top: 1px solid var(--colour-border-subtle);
  }

  .community-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--colour-surface-elevated, rgba(0, 0, 0, 0.04));
    border: 1px solid var(--colour-border-subtle);
    color: var(--colour-fg-muted);
  }

  .contributions-timeline-section {
    margin-bottom: var(--space-16);
  }

  .timeline-sequence {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    position: relative;
    padding-left: var(--space-4);
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 160px auto 1fr;
    gap: var(--space-6);
    align-items: flex-start;
  }

  .timeline-time-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: right;
  }

  .timeline-period-pill {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--accent-people, #a78bfa);
  }

  .timeline-org-name {
    font-size: 11px;
    color: var(--colour-fg-subtle);
  }

  .timeline-dot-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    padding-top: 4px;
  }

  .dot-node {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-people, #a78bfa);
    border: 2px solid var(--colour-surface);
    box-shadow: 0 0 0 2px rgba(167, 139, 250, 0.3);
  }

  .timeline-detail-col {
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .timeline-role-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
  }

  .timeline-role-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent-people, #a78bfa);
    background: rgba(167, 139, 250, 0.08);
    border: 1px solid rgba(167, 139, 250, 0.2);
    padding: 1px 6px;
    border-radius: 4px;
  }

  .timeline-title {
    font-size: var(--text-md);
    font-weight: 700;
    margin: 0;
  }

  .timeline-description {
    font-size: var(--text-xs);
    color: var(--colour-fg-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-3);
  }

  .timeline-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .mini-tag {
    font-family: var(--font-mono);
    font-size: 9px;
    padding: 1px 6px;
    border-radius: 3px;
    background: var(--colour-surface-elevated, rgba(0, 0, 0, 0.04));
    border: 1px solid var(--colour-border-subtle);
    color: var(--colour-fg-subtle);
  }

  .mentorship-values-section {
    margin-top: var(--space-12);
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .value-card {
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .value-title {
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--colour-fg);
    margin-bottom: var(--space-2);
  }

  .value-desc {
    font-size: var(--text-xs);
    color: var(--colour-fg-muted);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 640px) {
    .initiatives-grid,
    .values-grid {
      grid-template-columns: 1fr;
    }
    .timeline-item {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .timeline-time-col {
      text-align: left;
    }
    .timeline-dot-connector {
      display: none;
    }
  }
</style>
