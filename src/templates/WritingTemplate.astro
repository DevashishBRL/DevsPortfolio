---
/**
 * WritingTemplate.astro
 *
 * Reusable article template powered by Astro Content Collections.
 * Renders authored writing with metadata sidebar and markdown body.
 */
import PageLayout from '../layouts/PageLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'writing'>;
}

const { article } = Astro.props;
const { data } = article;
const { Content } = await article.render();

const base = import.meta.env.BASE_URL;

// Format the date for display
const dateObj = new Date(data.date);
const dateLabel = dateObj.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
---

<PageLayout
  title={`${data.title} - ${data.series}`}
  description={data.description}
  label={`${data.series} - ${dateLabel}`}
  heading={data.title}
  subheading={data.description}
>
  <article class="case-study" aria-label="Article">
    <div class="container case-study-grid">
      <div class="case-main">
        <div class="article-body">
          <Content />
        </div>
      </div>
      <aside class="case-meta" aria-label="Article details">
        <div class="case-meta-card">
          <dl class="case-meta-list">
            <div class="case-meta-item"><dt>Series</dt><dd>{data.series}</dd></div>
            <div class="case-meta-item"><dt>Published</dt><dd>{dateLabel}</dd></div>
            {data.tags && data.tags.length > 0 && (
              <div class="case-meta-item">
                <dt>Topics</dt>
                <dd>{data.tags.join(', ')}</dd>
              </div>
            )}
          </dl>
          {data.tags && data.tags.length > 0 && (
            <div class="case-meta-tags">
              {data.tags.map(t => <span class="tag">{t}</span>)}
            </div>
          )}
        </div>
        <a href={`${base}writing/`} class="back-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
          </svg>
          All articles
        </a>
      </aside>
    </div>
  </article>
</PageLayout>

