---
/**
 * ProjectTemplate.astro
 * 
 * Reusable editorial case study template powered by Astro Content Collections.
 * Renders verified problem, role, approach, outcome, sidebar metadata, and body.
 */
import PageLayout from '../layouts/PageLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await project.render();

const base = import.meta.env.BASE_URL;

// Status presentation format
const statusLabel = data.status === 'active' 
  ? 'Active' 
  : data.status === 'ongoing' 
    ? 'Ongoing' 
    : 'Completed';
---

<PageLayout
  title={`${data.title} - Devashish Tambade`}
  description={data.description}
  label={`Engineering - ${statusLabel}`}
  heading={data.title}
  subheading={data.subtitle}
>
  <article class="case-study" aria-label="Project case study">
    <div class="container case-study-grid">

      <!-- Main narrative sections -->
      <div class="case-main">

        {data.problem && (
          <section class="case-section" aria-labelledby="cs-problem">
            <h2 class="cs-heading" id="cs-problem">The Problem</h2>
            <p>{data.problem}</p>
          </section>
        )}

        {data.role && (
          <section class="case-section" aria-labelledby="cs-role">
            <h2 class="cs-heading" id="cs-role">My Role</h2>
            <p>{data.role}</p>
          </section>
        )}

        {data.approach && (
          <section class="case-section" aria-labelledby="cs-approach">
            <h2 class="cs-heading" id="cs-approach">Approach</h2>
            {data.approach.split('\n\n').map(p => (
              <p>{p}</p>
            ))}
          </section>
        )}

        {data.outcome && (
          <section class="case-section" aria-labelledby="cs-outcome">
            <h2 class="cs-heading" id="cs-outcome">Outcome</h2>
            <p>{data.outcome}</p>
            {data.note && (
              <div class="case-note">
                <p><strong>Note:</strong> {data.note}</p>
              </div>
            )}
          </section>
        )}

        <!-- Additional long-form markdown body if present -->
        <div class="article-body">
          <Content />
        </div>

      </div>

      <!-- Sidebar metadata -->
      <aside class="case-meta" aria-label="Project details">
        <div class="case-meta-card">
          <dl class="case-meta-list">
            <div class="case-meta-item">
              <dt>Type</dt>
              <dd>Engineering Case Study</dd>
            </div>
            <div class="case-meta-item">
              <dt>Status</dt>
              <dd>{statusLabel}</dd>
            </div>
            {data.discipline && (
              <div class="case-meta-item">
                <dt>Discipline</dt>
                <dd>{data.discipline}</dd>
              </div>
            )}
            {data.keySkills && data.keySkills.length > 0 && (
              <div class="case-meta-item">
                <dt>Key skills</dt>
                <dd>{data.keySkills.join(', ')}</dd>
              </div>
            )}
            {data.tools && data.tools.length > 0 && (
              <div class="case-meta-item">
                <dt>Tools</dt>
                <dd>{data.tools.join(', ')}</dd>
              </div>
            )}
          </dl>

          {data.tags && data.tags.length > 0 && (
            <div class="case-meta-tags">
              {data.tags.map(t => (
                <span class="tag">{t}</span>
              ))}
            </div>
          )}
        </div>

        <a href={`${base}work/`} class="back-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
          </svg>
          All projects
        </a>
      </aside>

    </div>
  </article>
</PageLayout>

